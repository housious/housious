

{% comment %} <div class="canva-marketing-engine" style="background-color: {{ section.settings.bg_color }};">
    <div class="section-container {{ section.settings.container_width }}"> {% endcomment %}
<div class="section-container {{ section.settings.container_width }}">
  <div class="canva-marketing-engine" style="background-color: {{ section.settings.bg_color }};">
 
        <div class="canva-main-split-layout-grid">
            <div class="canva-left-side-stack">
              <div class="canva-combo-gift-sub-row">
                <div class="canva-card combo-box-card">
                  <div class="combo-card-split-content">
                    <div class="combo-card-text-side">
                      <div class="card-text-header">
                        <span class="orange-star-tag">★ {{ section.settings.combo_tag }}</span>
                        <h3 class="canva-card-title">{{ section.settings.combo_title }}</h3>
                      </div>
                      <a
                      href="{{ section.settings.combo_button_link }}"
                      class="mobile-btn canva-solid-orange-btn combo-add-to-cart-btn"
                    >
                      <span>{{ section.settings.combo_btn_text }}</span>

                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path
                          d="M5 12H19"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                        />
                        <path
                          d="M13 6L19 12L13 18"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </a>
                    </div>
                    <div class="combo-card-image-side">
                      {%- if product.featured_image != blank -%}
                        <div class="canva-image-frame dynamic-product-preview-frame">
                          <img
                            src="{{ product.featured_image | image_url: width: 260 }}"
                            alt="{{ product.title | escape }}"
                            loading="lazy"
                          >
                        </div>
                      {%- else -%}
                        {%- if section.settings.combo_image != blank -%}
                          <div class="canva-image-frame">
                            <img
                              src="{{ section.settings.combo_image | image_url: width: 260 }}"
                              alt="Combo promotion preview"
                              loading="lazy"
                            >
                          </div>
                        {%- endif -%}
                      {%- endif -%}
                    </div>
                  </div>
                  {% comment %} <button
                    type="button"
                    class="desktop-btn canva-solid-orange-btn combo-add-to-cart-btn"
                    data-variant-one="{{ product.selected_or_first_available_variant.id }}"
                    data-variant-two="{{ section.settings.combo_product.selected_or_first_available_variant.id }}">
                    {{ section.settings.combo_btn_text }} →
                  </button> {% endcomment %}
                </div>

                {%- assign gift_product = product.metafields.custom.prepaid_free_gift_product.value -%}
                <div class="canva-card free-gift-card">
                  <div class="gift-card-split-content">
                    <div class="gift-card-text-side">
                      <div class="card-text-header">
                        <span class="gift-icon-badge">🎁 {{ section.settings.gift_tag }}</span>
                        <h3 class="canva-card-title gift-truncated-title">{{ section.settings.gift_title }}</h3>
                      </div>
                    </div>
                    <div class="gift-card-image-side">
                      <div class="canva-image-frame position-relative-gift">
                        {%- if gift_product != blank and gift_product.featured_image != blank -%}
                          <img
                            src="{{ gift_product.featured_image | image_url: width: 260 }}"
                            alt="{{ gift_product.title | escape }}"
                            loading="lazy"
                          >
                        {%- else -%}
                          {%- if section.settings.gift_image != blank -%}
                            <img
                              src="{{ section.settings.gift_image | image_url: width: 260 }}"
                              alt="Free gift product fallback"
                              loading="lazy"
                            >
                          {%- endif -%}
                        {%- endif -%}
                        <span class="canva-round-sticker-badge">FREE GIFT</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              {%- assign fbt_main_variant = product.selected_or_first_available_variant -%}
              {%- assign fbt_main_image = fbt_main_variant.featured_image | default: product.featured_image -%}
              {%- assign fbt_eligible_count = 0 -%}
              {%- if fbt_main_variant != blank -%}
                {%- assign fbt_eligible_count = 1 -%}
              {%- endif -%}

              {%- capture fbt_associated_cards -%}
                {%- if product.metafields.custom.frequently_bought_together.value != blank -%}
                  {%- for associative_product in product.metafields.custom.frequently_bought_together.value limit: 2 -%}
                    {%- assign fbt_associated_variant = associative_product.first_available_variant -%}
                    {%- if fbt_associated_variant != blank -%}
                      {%- assign fbt_associated_image = fbt_associated_variant.featured_image | default: associative_product.featured_image -%}
                      {%- assign fbt_eligible_count = fbt_eligible_count | plus: 1 -%}
                      <article
                        class="h-fbt-product-card is-selected"
                        data-fbt-item
                        data-variant-id="{{ fbt_associated_variant.id }}"
                        data-price="{{ fbt_associated_variant.price }}"
                        data-product-url="{{ associative_product.url }}"
                      >
                        <label class="h-fbt-check" aria-label="Include {{ associative_product.title | escape }}">
                          <input type="checkbox" data-fbt-toggle checked>
                          <span aria-hidden="true">✓</span>
                        </label>

                        <a
                          href="{{ associative_product.url }}?variant={{ fbt_associated_variant.id }}"
                          class="h-fbt-product-link h-fbt-product-image-link"
                          data-fbt-product-link
                          aria-label="View {{ associative_product.title | escape }}"
                        >
                          <img
                            src="{{ fbt_associated_image | image_url: width: 360 }}"
                            alt="{{ fbt_associated_image.alt | default: associative_product.title | escape }}"
                            loading="lazy"
                            data-fbt-product-image
                          >
                        </a>

                        <div class="h-fbt-product-meta">
                          <a
                            href="{{ associative_product.url }}?variant={{ fbt_associated_variant.id }}"
                            class="h-fbt-product-link h-fbt-product-title"
                            data-fbt-product-link
                          >
                            {{ associative_product.title }}
                          </a>

                          <div class="h-fbt-price-row">
                            <strong data-fbt-item-price>{{ fbt_associated_variant.price | money }}</strong>
                            <span
                              class="h-fbt-compare-price"
                              data-fbt-compare-price
                              {% unless fbt_associated_variant.compare_at_price > fbt_associated_variant.price %}hidden{% endunless %}
                            >
                              {%- if fbt_associated_variant.compare_at_price > fbt_associated_variant.price -%}
                                {{ fbt_associated_variant.compare_at_price | money }}
                              {%- endif -%}
                            </span>
                          </div>

                          {%- unless associative_product.has_only_default_variant -%}
                            <select
                              class="h-fbt-variant-select"
                              data-fbt-variant-select
                              aria-label="Choose variation for {{ associative_product.title | escape }}"
                            >
                              {%- for variant in associative_product.variants -%}
                                {%- if variant.available -%}
                                  {%- assign fbt_option_image = variant.featured_image | default: associative_product.featured_image -%}
                                  <option
                                    value="{{ variant.id }}"
                                    data-price="{{ variant.price }}"
                                    data-compare-price="{{ variant.compare_at_price | default: 0 }}"
                                    data-image="{% if fbt_option_image != blank %}{{ fbt_option_image | image_url: width: 360 }}{% endif %}"
                                    data-url="{{ associative_product.url }}?variant={{ variant.id }}"
                                    {% if variant.id == fbt_associated_variant.id %}selected{% endif %}
                                  >
                                    {{ variant.title }}
                                  </option>
                                {%- endif -%}
                              {%- endfor -%}
                            </select>
                          {%- else -%}
                            <span class="h-fbt-single-variant">Ready to add</span>
                          {%- endunless -%}
                        </div>
                      </article>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              {%- endcapture -%}

              {%- if fbt_eligible_count > 1 -%}
                <div
                  class="canva-fbt-integrated-footer-panel h-fbt-panel"
                  data-fbt-panel
                  data-fbt-main-variant-id="{{ fbt_main_variant.id }}"
                  data-fbt-main-price="{{ fbt_main_variant.price }}"
                  data-fbt-main-available="{{ fbt_main_variant.available }}"
                  data-fbt-main-url="{{ product.url }}"
                >
                  <div class="h-fbt-heading-row">
                    <div>
                      <span class="h-fbt-kicker">Recommended Set</span>
                      <h4 class="fbt-panel-header-title">Frequently Bought Together</h4>
                    </div>
                    <span class="h-fbt-selected-count" data-fbt-selected-count></span>
                  </div>

                  <div class="h-fbt-layout">
                    <div class="h-fbt-products-grid">
                      <article
                        class="h-fbt-product-card is-selected is-required"
                        data-fbt-main-item
                        data-fbt-item
                        data-variant-id="{{ fbt_main_variant.id }}"
                        data-price="{{ fbt_main_variant.price }}"
                      >
                        <span class="h-fbt-check is-locked" aria-label="Current product included">
                          <input type="checkbox" checked disabled>
                          <span aria-hidden="true">✓</span>
                        </span>

                        <a
                          href="{{ product.url }}?variant={{ fbt_main_variant.id }}"
                          class="h-fbt-product-link h-fbt-product-image-link"
                          data-fbt-main-link
                        >
                          <img
                            src="{{ fbt_main_image | image_url: width: 360 }}"
                            alt="{{ fbt_main_image.alt | default: product.title | escape }}"
                            loading="lazy"
                            data-fbt-main-image
                          >
                        </a>

                        <div class="h-fbt-product-meta">
                          <a
                            href="{{ product.url }}?variant={{ fbt_main_variant.id }}"
                            class="h-fbt-product-link h-fbt-product-title"
                            data-fbt-main-link
                          >
                            {{ product.title }}
                          </a>

                          <div class="h-fbt-price-row">
                            <strong data-fbt-main-price-label>{{ fbt_main_variant.price | money }}</strong>
                            <span
                              class="h-fbt-compare-price"
                              data-fbt-main-compare-price
                              {% unless fbt_main_variant.compare_at_price > fbt_main_variant.price %}hidden{% endunless %}
                            >
                              {%- if fbt_main_variant.compare_at_price > fbt_main_variant.price -%}
                                {{ fbt_main_variant.compare_at_price | money }}
                              {%- endif -%}
                            </span>
                          </div>

                          {%- unless product.has_only_default_variant -%}
                            <span class="h-fbt-main-variant" data-fbt-main-variant-label>
                              Selected: {{ fbt_main_variant.title }}
                            </span>
                          {%- else -%}
                            <span class="h-fbt-single-variant">Current product</span>
                          {%- endunless -%}
                        </div>
                      </article>

                      {{ fbt_associated_cards }}
                    </div>

                    <aside class="h-fbt-summary">
                      <span class="h-fbt-summary-label">Selected Total</span>
                      <strong class="h-fbt-summary-price" data-fbt-total-price></strong>
                      <span class="h-fbt-summary-note">Quantity offers, if eligible, apply in cart.</span>
                      <button
                        type="button"
                        class="canva-huge-action-submit-btn h-fbt-add-btn"
                        id="HousiousAddAllToCartTrigger"
                      >
                        Add Selected to Cart
                      </button>
                    </aside>
                  </div>
                </div>
              {%- endif -%}
            </div>

            <div class="canva-card you-may-like-wide-card">
              <h3 class="collection-main-heading">{{ section.settings.collection_title }}</h3>

              <div class="canva-products-horizontal-row-grid">
                {%- assign selected_collection = collections[section.settings.featured_collection] -%}

                {%- if selected_collection == blank and product.collections.size > 0 -%}
                  {%- for product_collection in product.collections -%}
                    {%- unless product_collection.handle == 'all' or product_collection.handle == 'best-seller' or product_collection.handle == 'new-arrival' or product_collection.handle == 'featured-products' or product_collection.handle == 'under-499' -%}
                      {%- assign selected_collection = product_collection -%}
                      {%- break -%}
                    {%- endunless -%}
                  {%- endfor -%}
                {%- endif -%}

                {%- if selected_collection == blank and product.collections.size > 0 -%}
                  {%- assign selected_collection = product.collections.first -%}
                {%- endif -%}

                {%- if selected_collection != blank and selected_collection.products_count > 0 -%}
                  {% comment %}
                    {%- for col_product in selected_collection.products limit: 3 -%}
                      <div class="vertical-product-card-node">
                        <a href="{{ col_product.url }}" class="card-link-wrapper">
                          <div class="card-img-holder">
                            {%- if col_product.featured_image != blank -%}
                              <img src="{{ col_product.featured_image | image_url: width: 220 }}" alt="{{ col_product.title | escape }}" loading="lazy">
                            {%- else -%}
                              Product Image
                            {%- endif -%}
                          </div>
                          <div class="card-meta-details">
                            <h4 class="card-product-title">{{ col_product.title | truncate: 38 }}</h4>
                            <div class="card-rating-stars">4.6 ★ <span class="rating-count-label">(1,248)</span></div>
                            <p class="card-pricing-line">
                              <span class="card-sale-price">{{ col_product.price | money }}</span>
                              {%- if col_product.compare_at_price > col_product.price -%}
                                <span class="card-strike-price">{{ col_product.compare_at_price | money }}</span>
                                <span class="card-pct-discount">{{ col_product.compare_at_price | minus: col_product.price | times: 100 | divided_by: col_product.compare_at_price }}% OFF</span>
                              {%- endif -%}
                            </p>
                            <div class="prepaid-price-pill">Prepaid Price <span class="pill-bold-amt">{{ col_product.price | times: 0.9 | money }}</span></div>
                          </div>
                        </a>
                      </div>
                    {%- endfor -%}
                  {% endcomment %}

                  {%- assign recommendations_rendered = 0 -%}
                  {%- for col_product in selected_collection.products limit: 8 -%}
                    {%- if col_product.id != product.id and recommendations_rendered < 2 -%}
                      {%- assign recommendations_rendered = recommendations_rendered | plus: 1 -%}
                <div class="vertical-product-card-node">
                  <div class="card-link-wrapper">
                    <a href="{{ col_product.url }}" class="card-img-holder">
                      <img src="{{ col_product.featured_image | image_url: width: 220 }}" alt="{{ col_product.title | escape }}" loading="lazy">
                    </a>
                    
                    <div class="card-meta-details">
                      <h4 class="card-product-title">{{ col_product.title }}</h4>
                      
                      

                      <p class="card-pricing-line">
                        <span class="card-sale-price">{{ col_product.price | money }}</span>
                        {%- if col_product.compare_at_price > col_product.price -%}
                          <span class="card-strike-price">{{ col_product.compare_at_price | money }}</span>
                        {%- endif -%}
                      </p>

                      {%- assign air_review_count = col_product.metafields.air_reviews_product.review_count.value | default: col_product.metafields.air_reviews_product.review_count -%}
                      <div class="rating rating--dynamic">
                        <div class="air-reviews-product-stars" data-js-air-reviews-product-stars data-id="{{ col_product.id }}"></div>
                        {%- if air_review_count != blank and air_review_count != 0 -%}
                          <span class="divider"></span>
                          <div class="reviews"><span>{{ air_review_count }} reviews</span></div>
                        {%- endif -%}
                      </div>

                      {% comment %} {%- if col_product.metafields.custom.prepaid_price != blank -%}
                        <div class="prepaid-price-pill">
                          Prepaid Price <span class="pill-bold-amt">{{ col_product.metafields.custom.prepaid_price | money_without_trailing_zeros }}</span>
                        </div>
                      {%- endif -%} {% endcomment %}

                      {% comment %} --- NEW ADD TO CART BUTTON --- {% endcomment %}
                      {%- form 'product', col_product, id: null, class: 'form-add-to-cart-wrapper',data-type: 'add-to-cart-form', novalidate: 'novalidate' -%}
                          
                          <input type="hidden" name="id" value="{{ col_product.selected_or_first_available_variant.id }}">
                          <input type="hidden" name="quantity" value="1">

                          {% if settings.cart_type == 'page' %}
                            <button type="submit" name="add" class="btn-add-to-cart" >
                              <span class="btn-icon" >
                                <svg
                                  xmlns="http://www.w3.org/2000/svg"
                                  width="20"
                                  height="20"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  aria-hidden="true">

                                  <path
                                    d="M3 4H5L7.4 15.2C7.5 15.7 7.9 16 8.4 16H18.8C19.3 16 19.7 15.7 19.8 15.2L21 7H7"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"/>

                                  <circle
                                    cx="9"
                                    cy="20"
                                    r="1.5"
                                    fill="currentColor"/>

                                  <circle
                                    cx="18"
                                    cy="20"
                                    r="1.5"
                                    fill="currentColor"/>

                                </svg>
                              </span> Add to Cart
                                    </button>
                                  {% else %}
                                    <button type="submit" name="add" class="card-add-to-cart-btn">
                                      <span class="btn-icon">
                                <svg
                                  xmlns="http://www.w3.org/2000/svg"
                                  width="20"
                                  height="20"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  aria-hidden="true">

                                  <path
                                    d="M3 4H5L7.4 15.2C7.5 15.7 7.9 16 8.4 16H18.8C19.3 16 19.7 15.7 19.8 15.2L21 7H7"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"/>

                                  <circle
                                    cx="9"
                                    cy="20"
                                    r="1.5"
                                    fill="currentColor"/>

                                  <circle
                                    cx="18"
                                    cy="20"
                                    r="1.5"
                                    fill="currentColor"/>

                                </svg>
                              </span>Add to Cart
                                    </button>
                                  {% endif %}

                        {%- endform -%}
                    </div>
                  </div>
                </div>
                    {%- endif -%}
                {%- endfor -%}
                  {% comment %} {%- for col_product in selected_collection.products limit: 3 -%}
                    <div class="vertical-product-card-node">
                      <a href="{{ col_product.url }}" class="card-link-wrapper">
                        <div class="card-img-holder">
                          <img
                            src="{{ col_product.featured_image | image_url: width: 220 }}"
                            alt="{{ col_product.title | escape }}"
                            loading="lazy"
                          >
                        </div>
                        <div class="card-meta-details">
                          <!-- Dynamic Title -->
                          <h4 class="card-product-title">{{ col_product.title }}</h4>

                          <!-- Dynamic Rating (Assuming you use an app like Judge.me or AirReviews) -->
                          <div class="card-rating-stars">
                            {% comment %} Replace this with your actual app's snippet {% endcomment %}
                            <div class="air-reviews-product-stars" data-id="{{ col_product.id }}"></div>
                          </div>

                          <p class="card-pricing-line">
                            <span class="card-sale-price">{{ col_product.price | money }}</span>
                            {%- if col_product.compare_at_price > col_product.price -%}
                              <span class="card-strike-price">{{ col_product.compare_at_price | money }}</span>
                            {%- endif -%}
                          </p>

                          <!-- Dynamic Prepaid Price from Metafields -->
                          {%- if col_product.metafields.custom.prepaid_price != blank -%}
                            <div class="prepaid-price-pill">
                              Prepaid Price
                              <span class="pill-bold-amt">
                                {{ col_product.metafields.custom.prepaid_price | money_without_trailing_zeros }}
                              </span>
                            </div>
                          {%- endif -%}
                        </div>
                      </a>
                    </div>
                  {%- endfor -%} {% endcomment %}
                  {% comment %}
                    {%- for col_product in selected_collection.products limit: 3 -%}
                      {% render 'product-card', card_product: col_product %}
                    {%- endfor -%}
                  {% endcomment %}
                {%- else -%}
                  <p class="recommendations-empty" style="grid-column:1 / -1;color:#666;margin:0;">Recommendations are being updated.</p>
                {%- endif -%}
              </div>
            </div>
        </div>
  </div>
</div>
{% schema %}
{
  "name": "Housious Marketing Grid",
  "settings": [
    {
      "type": "select",
      "id": "container_width",
      "label": "Container Width",
      "options": [
        { "value": "section-container--lg", "label": "Large" },
        { "value": "section-container--xl", "label": "Extra Large" },
        { "value": "section-container--full", "label": "Full Width" }
      ],
      "default": "section-container--xl"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Card 1: Combo Settings"
    },
    {
      "type": "text",
      "id": "combo_tag",
      "label": "Combo Badge Text",
      "default": "Combo & Save More"
    },
    {
      "type": "text",
      "id": "combo_title",
      "label": "Combo Heading",
      "default": "Buy 2+ items & save up to 15%"
    },
    {
      "type": "image_picker",
      "id": "combo_image",
      "label": "Combo Product Image"
    },
    {
      "type": "text",
      "id": "combo_btn_text",
      "label": "Button Text",
      "default": "Shop Combos"
    },
    {
      "type": "url",
      "id": "combo_button_link",
      "label": "Combo Button Link"
    },
    {
      "type": "header",
      "content": "Card 2: Free Gift Settings"
    },
    {
      "type": "text",
      "id": "gift_tag",
      "label": "Gift Badge Text",
      "default": "Free Gift on Orders Above ₹999"
    },
    {
      "type": "text",
      "id": "gift_title",
      "label": "Gift Conditions Label",
      "default": "Get a free product worth ₹199 on orders above ₹999"
    },
    {
      "type": "image_picker",
      "id": "gift_image",
      "label": "Free Gift Product Image"
    },
    {
      "type": "header",
      "content": "Card 3: You May Also Like"
    },
    {
      "type": "text",
      "id": "collection_title",
      "label": "Collection Heading Title",
      "default": "You May Also Like"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Select Manual Collection"
    },
    {
      "type": "header",
      "content": "Bottom FBT Pricing Core"
    },
    {
      "type": "text",
      "id": "discount_label",
      "label": "Discount Value Pill",
      "default": "33% OFF"
    }
  ],
  "presets": [
    {
      "name": "Housious Marketing Grid"
    }
  ]
}
{% endschema %}

{{ 'housious-marketing-blocks.css' | asset_url | stylesheet_tag }}
<style>
  .h-fbt-panel {
    display: block;
    padding: 18px;
    border-color: #f2d7c8;
    background: linear-gradient(180deg, #fff 0%, #fffaf7 100%);
  }
  .h-fbt-heading-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 14px;
  }
  .h-fbt-heading-row .fbt-panel-header-title {
    margin-top: 3px;
    text-align: left;
    font-size: clamp(18px, 2vw, 24px);
  }
  .h-fbt-kicker {
    display: inline-flex;
    padding: 4px 8px;
    border-radius: 999px;
    background: #fff0e8;
    color: #ff5600;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  .h-fbt-selected-count {
    flex: 0 0 auto;
    padding: 6px 9px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid #f0e3dc;
    color: #555;
    font-size: 10px;
    font-weight: 700;
  }
  .h-fbt-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(180px, 220px);
    gap: 16px;
    align-items: stretch;
  }
  .h-fbt-products-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    min-width: 0;
  }
  .h-fbt-product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid #ececec;
    border-radius: 10px;
    background: #fff;
    transition: opacity .2s ease, border-color .2s ease, box-shadow .2s ease;
  }
  .h-fbt-product-card.is-selected {
    border-color: #f7cbb4;
    box-shadow: 0 3px 12px rgba(255, 86, 0, .06);
  }
  .h-fbt-product-card:not(.is-selected) {
    opacity: .56;
  }
  .h-fbt-check {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 2;
    display: inline-flex;
    width: 23px;
    height: 23px;
    align-items: center;
    justify-content: center;
    border: 1px solid #d8d8d8;
    border-radius: 6px;
    background: #fff;
    cursor: pointer;
  }
  .h-fbt-check input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .h-fbt-check > span {
    display: none;
    color: #fff;
    font-size: 13px;
    font-weight: 900;
  }
  .h-fbt-check:has(input:checked) {
    border-color: #ff5600;
    background: #ff5600;
  }
  .h-fbt-check:has(input:checked) > span {
    display: block;
  }
  .h-fbt-check.is-locked {
    cursor: default;
  }
  .h-fbt-product-image-link {
    display: flex;
    aspect-ratio: 1 / .78;
    padding: 12px;
    align-items: center;
    justify-content: center;
    background: #fafafa;
  }
  .h-fbt-product-image-link img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .h-fbt-product-meta {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 7px;
    padding: 10px;
  }
  .h-fbt-product-link {
    color: inherit;
    text-decoration: none;
  }
  .h-fbt-product-title {
    display: -webkit-box;
    min-height: 34px;
    overflow: hidden;
    color: #171717;
    font-size: 11px;
    font-weight: 750;
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .h-fbt-price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 5px;
    color: #111;
    font-size: 12px;
  }
  .h-fbt-compare-price {
    color: #999;
    font-size: 10px;
    text-decoration: line-through;
  }
  .h-fbt-variant-select {
    width: 100%;
    min-height: 34px;
    margin-top: auto;
    padding: 6px 28px 6px 8px;
    border: 1px solid #ddd;
    border-radius: 6px;
    background: #fff;
    color: #333;
    font-size: 10px;
  }
  .h-fbt-main-variant,
  .h-fbt-single-variant {
    margin-top: auto;
    color: #666;
    font-size: 9px;
    line-height: 1.3;
  }
  .h-fbt-summary {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: 16px;
    border-left: 1px solid #f0e3dc;
  }
  .h-fbt-summary-label {
    color: #666;
    font-size: 10px;
    font-weight: 700;
  }
  .h-fbt-summary-price {
    margin: 3px 0 4px;
    color: #111;
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.1;
  }
  .h-fbt-summary-note {
    margin-bottom: 12px;
    color: #777;
