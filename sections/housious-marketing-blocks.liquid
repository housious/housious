  }
  @media (max-width: 1100px) {
    .h-fbt-layout {
      grid-template-columns: 1fr;
    }
    .h-fbt-summary {
      border-top: 1px solid #f0e3dc;
      border-left: 0;
    }
  }
  @media (max-width: 640px) {
    .h-fbt-panel {
      padding: 13px;
    }
    .h-fbt-heading-row {
      align-items: center;
    }
    .h-fbt-products-grid {
      grid-template-columns: 1fr;
    }
    .h-fbt-product-card {
      display: grid;
      grid-template-columns: 88px minmax(0, 1fr);
      min-height: 112px;
    }
    .h-fbt-product-image-link {
      grid-row: 1;
      grid-column: 1;
      aspect-ratio: auto;
      min-height: 112px;
      padding: 9px;
    }
    .h-fbt-product-meta {
      grid-row: 1;
      grid-column: 2;
      padding: 10px;
    }
    .h-fbt-check {
      top: 6px;
      left: 6px;
    }
    .h-fbt-summary {
      padding: 13px 0 0;
    }
  }
</style>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const addAllBtn = document.getElementById('HousiousAddAllToCartTrigger');
    const fbtPanel = document.querySelector('[data-fbt-panel]');

    if (addAllBtn && fbtPanel) {
      const formatMoney = (paise) => new Intl.NumberFormat('en-IN', {
        style: 'currency',
        currency: 'INR',
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }).format((Number(paise) || 0) / 100);

      const getMainItem = () => ({
        id: parseInt(fbtPanel.dataset.fbtMainVariantId, 10),
        quantity: 1,
        price: parseInt(fbtPanel.dataset.fbtMainPrice, 10) || 0
      });

      const getAssociatedCards = () => Array.from(fbtPanel.querySelectorAll('[data-fbt-item]:not([data-fbt-main-item])'));

      const getSelectedItems = () => {
        const mainItem = getMainItem();
        const items = mainItem.id ? [mainItem] : [];

        getAssociatedCards().forEach((card) => {
          const toggle = card.querySelector('[data-fbt-toggle]');
          if (toggle && !toggle.checked) return;

          const id = parseInt(card.dataset.variantId, 10);
          const price = parseInt(card.dataset.price, 10) || 0;
          if (id) items.push({ id, quantity: 1, price });
        });

        return items;
      };

      const updateSummary = () => {
        const items = getSelectedItems();
        const count = items.length;
        const total = items.reduce((sum, item) => sum + item.price, 0);
        const totalEl = fbtPanel.querySelector('[data-fbt-total-price]');
        const countEl = fbtPanel.querySelector('[data-fbt-selected-count]');

        if (totalEl) totalEl.textContent = formatMoney(total);
        if (countEl) countEl.textContent = `${count} item${count === 1 ? '' : 's'} selected`;

        addAllBtn.textContent = count === 1
          ? 'Add 1 Selected Item'
          : `Add ${count} Selected Items`;
        addAllBtn.disabled = fbtPanel.dataset.fbtMainAvailable !== 'true' || count === 0;
      };

      getAssociatedCards().forEach((card) => {
        const toggle = card.querySelector('[data-fbt-toggle]');
        const select = card.querySelector('[data-fbt-variant-select]');

        if (toggle) {
          toggle.addEventListener('change', () => {
            card.classList.toggle('is-selected', toggle.checked);
            updateSummary();
          });
        }

        if (select) {
          select.addEventListener('change', () => {
            const option = select.options[select.selectedIndex];
            const variantId = parseInt(option.value, 10);
            const price = parseInt(option.dataset.price, 10) || 0;
            const comparePrice = parseInt(option.dataset.comparePrice, 10) || 0;
            const imageUrl = option.dataset.image || '';
            const productUrl = option.dataset.url || card.dataset.productUrl || '';

            card.dataset.variantId = variantId || '';
            card.dataset.price = String(price);

            const image = card.querySelector('[data-fbt-product-image]');
            if (image && imageUrl) image.src = imageUrl;

            card.querySelectorAll('[data-fbt-product-link]').forEach((link) => {
              if (productUrl) link.href = productUrl;
            });

            const priceEl = card.querySelector('[data-fbt-item-price]');
            if (priceEl) priceEl.textContent = formatMoney(price);

            const compareEl = card.querySelector('[data-fbt-compare-price]');
            if (compareEl) {
              const hasCompare = comparePrice > price;
              compareEl.hidden = !hasCompare;
              compareEl.textContent = hasCompare ? formatMoney(comparePrice) : '';
            }

            updateSummary();
          });
        }
      });

      const updateMainFbtState = (variant) => {
        if (!variant) return;

        const mainNode = fbtPanel.querySelector('[data-fbt-main-item]');
        const mainPriceEl = fbtPanel.querySelector('[data-fbt-main-price-label]');
        const mainCompareEl = fbtPanel.querySelector('[data-fbt-main-compare-price]');
        const mainVariantLabel = fbtPanel.querySelector('[data-fbt-main-variant-label]');
        const mainImage = fbtPanel.querySelector('[data-fbt-main-image]');
        const mainLinks = fbtPanel.querySelectorAll('[data-fbt-main-link]');

        const price = parseInt(variant.price, 10) || 0;
        const comparePrice = parseInt(variant.compareAtPrice, 10) || 0;
        const variantId = parseInt(variant.id, 10);

        fbtPanel.dataset.fbtMainVariantId = variantId || '';
        fbtPanel.dataset.fbtMainPrice = String(price);
        fbtPanel.dataset.fbtMainAvailable = String(variant.available === true);

        if (mainNode) {
          mainNode.dataset.variantId = variantId || '';
          mainNode.dataset.price = String(price);
        }

        if (mainPriceEl) mainPriceEl.textContent = formatMoney(price);

        if (mainCompareEl) {
          const hasCompare = comparePrice > price;
          mainCompareEl.hidden = !hasCompare;
          mainCompareEl.textContent = hasCompare ? formatMoney(comparePrice) : '';
        }

        if (mainVariantLabel && Array.isArray(variant.options)) {
          mainVariantLabel.textContent = `Selected: ${variant.options.join(' / ')}`;
        }

        const selectedImage = variant.media?.src400 || variant.media?.src || '';
        if (mainImage && selectedImage) {
          mainImage.src = selectedImage;
          if (variant.media?.alt) mainImage.alt = variant.media.alt;
        }

        if (variantId) {
          const mainUrl = `${fbtPanel.dataset.fbtMainUrl}?variant=${variantId}`;
          mainLinks.forEach((link) => { link.href = mainUrl; });
        }

        updateSummary();
      };

      updateSummary();

      document.addEventListener('variant:change', function (event) {
        const variant = event.detail?.variant;
        if (!variant || !event.target.closest('.housious-product-page')) return;
        updateMainFbtState(variant);
      });

      addAllBtn.addEventListener('click', async function (e) {
        e.preventDefault();

        const selectedItems = getSelectedItems();
        if (!selectedItems.length || fbtPanel.dataset.fbtMainAvailable !== 'true') return;

        const items = selectedItems.map(({ id, quantity }) => ({ id, quantity }));
        const originalText = addAllBtn.textContent;
        addAllBtn.disabled = true;
        addAllBtn.textContent = 'Adding...';

        try {
          if (window.CartDrawer && typeof window.CartDrawer.addItemsToCart === 'function') {
            await window.CartDrawer.addItemsToCart(items);
          } else {
            const response = await fetch('/cart/add.js', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify({ items })
            });

            if (!response.ok) {
              const error = await response.json();
              throw new Error(error.description || 'Could not add products');
            }

            window.location.href = '/cart';
          }
        } catch (error) {
          console.error(error);
          alert(error.message || 'Something went wrong');
        } finally {
          addAllBtn.textContent = originalText;
          updateSummary();
        }
      });
    }

    const comboBtn = document.querySelector('.combo-add-to-cart-btn');
    if (!comboBtn) return;

    comboBtn.addEventListener('click', async function (e) {
      e.preventDefault();

      const variantOne = parseInt(comboBtn.dataset.variantOne, 10);
      const variantTwo = parseInt(comboBtn.dataset.variantTwo, 10);

      const items = [];

      if (variantOne) {
        items.push({ id: variantOne, quantity: 2 });
      }

      if (variantTwo) {
        items.push({ id: variantTwo, quantity: 2 });
      }

      if (!items.length) return;

      comboBtn.disabled = true;
      comboBtn.textContent = 'Adding...';

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ items })
        });

        if (!response.ok) throw new Error('Could not add products');

        if (window.CartDrawer && typeof window.CartDrawer.open === 'function') {
          window.CartDrawer.open();
        } else {
          window.location.href = '/cart';
        }

      } catch (error) {
        alert(error.message || 'Something went wrong');
      } finally {
        comboBtn.disabled = false;
        comboBtn.textContent = '{{ section.settings.combo_btn_text }} →';
      }
    });
  });
</script>