{{ 'blog.css' | asset_url | stylesheet_tag }}

{% comment %} <div class="blog-page container">
  <h1>{{ blog.title }}</h1>

  <div class="blog-grid">
    {% comment %}
      {% for article in blog.articles %}
    {% endcomment %}
    {% for article in blogs.news.articles %}
      <div class="blog-card">
        {% if article.image %}
          <div class="blog-image">
            <img
              src="{{ article.image | img_url: '600x' }}"
              alt="{{ article.title }}"
            >
          </div>
        {% endif %}

        <div class="blog-content">
          <p class="blog-date">
            {{ article.published_at | date: '%b %d, %Y' }}
          </p>

          <h2>
            <a href="{{ article.url }}">
              {{ article.title }}
            </a>
          </h2>

          <p>
            {{ article.excerpt | strip_html | truncate: 120 }}
          </p>

          <a class="read-more" href="{{ article.url }}"> Read More → </a>
        </div>
      </div>
    {% endfor %}
  </div>
</div> {% endcomment %}



<section class="blog-section section-container {{ section.settings.container_width }}">
  <div class="blog-container">
    {% if section.settings.heading != blank %}
      <h1 class="blog-main-title">{{ section.settings.heading }}</h1>
    {% endif %}

    <div class="blog-grid">
      {% for article in blogs['news'].articles %}
      <div class="blog-card">
        {% if article.image %}
          <div class="blog-image">
            <img src="{{ article.image | img_url: '600x' }}" alt="{{ article.title }}">
          </div>
        {% endif %}

        <div class="blog-content">
          <p class="blog-date">{{ article.published_at | date: '%b %d, %Y' }}</p>
          <h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
          <p>{{ article.excerpt | strip_html | truncate: 120 }}</p>
          <a class="read-more" href="{{ article.url }}">Read More →</a>
        </div>
      </div>
    {% endfor %}
    </div>
  </div>
</section>

{% comment %} <section class="blog-page section-container {{ section.settings.container_width }}">
  <div class="blog">
  {% if section.settings.heading != blank %}
    <h1 class="blog-main-title">{{ section.settings.heading }}</h1>
  {% endif %}

  <div class="blog-grid">
    {% for article in blogs['news'].articles %}
      <div class="blog-card">
        {% if article.image %}
          <div class="blog-image">
            <img src="{{ article.image | img_url: '600x' }}" alt="{{ article.title }}">
          </div>
        {% endif %}

        <div class="blog-content">
          <p class="blog-date">{{ article.published_at | date: '%b %d, %Y' }}</p>
          <h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
          <p>{{ article.excerpt | strip_html | truncate: 120 }}</p>
          <a class="read-more" href="{{ article.url }}">Read More →</a>
        </div>
      </div>
    {% endfor %}
  </div>
  </div> {% endcomment %}

</section>

{% comment %} 
<style>
  /* 1. Main Section Spacing Fix */
.blog-section {
  padding: 40px 0; /* Left/Right padding 0 rakhein, container handle karega */
}

/* 2. Grid Spacing Fix */
.blog-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
  gap: 30px;
  width: 100%;
}

/* 3. Mobile par extra margin hatane ke liye */
@media screen and (max-width: 768px) {
  .blog-section {
    padding: 20px 10px; /* Mobile par thodi safe spacing */
  }
  
  .blog-grid {
    grid-template-columns: 1fr; /* Mobile par 1 column */
    gap: 15px;
  }
}
  </style> {% endcomment %}

{% schema %}
{
  "name": "Blog Cards",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Blog"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container Width",
      "options": [
        { "value": "section-container--lg", "label": "Large" },
        { "value": "section-container--xl", "label": "Extra Large" },
        { "value": "section-container--full", "label": "Full Width" }
      ],
      "default": "section-container--xl"
    }
  ],
  "presets": [
    {
      "name": "Blog Cards"
    }
  ]
}
{% endschema %}