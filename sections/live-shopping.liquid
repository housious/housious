{{ 'live-shopping.css' | asset_url | stylesheet_tag }}

<section class="live-shopping-container" data-live-now="{{ section.settings.is_live_now }}">
  <h1 class="housious-visually-hidden">Housious Live Shopping</h1>
  <div class="section-container {{ section.settings.container_width }}">
    <div class="live-grid-wrapper">
      <!-- LEFT SIDE: VIDEO -->
      <div class="live-video-area">
        <div class="video-container">
          {% if section.settings.video_url != blank %}
    {%- if section.settings.video_url.type == 'youtube' -%}
      <iframe src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1&loop=1&mute=1&playlist={{ section.settings.video_url.id }}&controls=0" frameborder="0" allow="autoplay" class="main-live-video" id="liveVideo"></iframe>
    {%- elsif section.settings.video_url.type == 'vimeo' -%}
      <iframe src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1&loop=1&muted=1" frameborder="0" allow="autoplay" class="main-live-video" id="liveVideo"></iframe>
    {%- endif -%}
  {% else %}
    {% comment %} Agar link nahi hai, toh uploaded video dikhao {% endcomment %}
    {{ section.settings.live_video | video_tag: 
       autoplay: true, 
       loop: true, 
       muted: true, 
       playsinline: true, 
         controls: true, 
       class: 'main-live-video', 
       id: 'liveVideo' 
       
    }}
  {% endif %}
          {% comment %} {{ section.settings.live_video | video_tag: 
     autoplay: true, 
     loop: true, 
     muted: true, 
     playsinline: true, 
     controls: true, 
     class: 'main-live-video', 
     id: 'liveVideo' 
  }}  {% endcomment %}
  <div class="floating-actions">
    <button id="likeBtn" class="action-btn">
  {% comment %} <svg viewBox="0 0 64 64" class="heart-svg">
    <circle cx="32" cy="32" r="30" fill="#ff3b5c"/>
    <path
      fill="#fff"
      d="M32 45s-11-7.5-11-16.5c0-4.2 2.9-7.5 6.8-7.5
      2.2 0 3.7 1.2 4.2 2.8.5-1.6 2-2.8 4.2-2.8
      3.9 0 6.8 3.3 6.8 7.5C43 37.5 32 45 32 45z"/>
  </svg> {% endcomment %}
  
  <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="heart-svg">
    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
  </svg>

</button>

    {% comment %} <button id="likeBtn" class="action-btn">❤️</button> {% endcomment %}
    {% comment %} <button class="action-btn">🛍️</button> {% endcomment %}
  </div>

          {%- if section.settings.is_live_now -%}
            <div class="live-status">
              <div class="live-text-wrapper">
                <span class="live-dot"></span>
                <span class="live-text">LIVE</span>
              </div>
            </div>
          {%- endif -%}

          {%- assign highlight_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'highlight' and block.settings.text != blank -%}
              {%- assign highlight_count = highlight_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if highlight_count > 0 -%}
            <div class="today-highlights">
              <h3>{{ section.settings.highlight_heading }}</h3>
              <ul>
                {% for block in section.blocks -%}
                  {%- if block.type == 'highlight' and block.settings.text != blank -%}
                    <li>✔ {{ block.settings.text }}</li>
                  {%- endif -%}
                {%- endfor %}
              </ul>
            </div>
          {%- endif -%}

         
        </div>
        <div class="features-bar">
          {% for block in section.blocks %}
            {% if block.type == 'feature' %}
              <div class="feature-item">
                {% if block.settings.icon %}
                  <img src="{{ block.settings.icon | img_url: '40x' }}" alt="{{ block.settings.heading }}">
                {% endif %}
                <div class="feature-text">
                  <strong>{{ block.settings.heading }}</strong>
                  <span>{{ block.settings.subheading }}</span>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        {%- assign upcoming_count = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'upcoming_session' -%}
            {%- assign upcoming_count = upcoming_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if upcoming_count > 0 -%}
          <section class="upcoming-sessions-container">
            <h2>Upcoming Live Sessions</h2>
            <div class="sessions-grid">
              {% for block in section.blocks %}
                {% if block.type == 'upcoming_session' %}
                  <div class="session-card">
                    <div class="session-left">
                      <span class="session-badge">Upcoming</span>
                      {% if block.settings.image != blank %}
                        <img
                          src="{{ block.settings.image | image_url: width: 300 }}"
                          alt="{{ block.settings.title | escape }}"
                          width="300"
                          height="300"
                          loading="lazy"
                        >
                      {% endif %}
                    </div>
                    <div class="session-right">
                      {% if block.settings.badge != blank %}<span class="session-date">{{ block.settings.badge }}</span>{% endif %}
                      <h3>{{ block.settings.title }}</h3>
                      {% if block.settings.button_link != blank and block.settings.button_text != blank %}
                        <a href="{{ block.settings.button_link }}" class="session-btn">{{ block.settings.button_text }}</a>
                      {% endif %}
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </section>
        {%- endif -%}
      </div>

      <!-- RIGHT SIDE: SIDEBAR -->
      <div class="live-sidebar">
        <div class="tabs">
          <button class="tab-btn active">Shop the Live</button>
          {% comment %} <button class="tab-btn">Live Chat</button> {% endcomment %}
        </div>

        <div class="live-deals-header">
          <div class="deal-heading">
            🔥
            <h3>{{ section.settings.deals_heading }}</h3>
          </div>
          {%- if section.settings.is_live_now -%}
            <div class="deal-timer" aria-label="Live session offer">Live-session offers</div>
          {%- endif -%}
        </div>

        <div class="product-list">
          {% for block in section.blocks -%}
            {%- if block.type == 'product' -%}
              {%- render 'live-product-card', product: block.settings.product -%}
            {%- endif -%}
          {%- endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Live Shopping Section",
  "settings": [
    {
      "type": "select",
      "id": "container_width",
      "label": "Container Width",
      "options": [
        {
          "value": "section-container--sm",
          "label": "Small"
        },
        {
          "value": "section-container--md",
          "label": "Medium"
        },
        {
          "value": "section-container--lg",
          "label": "Large"
        },
        {
          "value": "section-container--xl",
          "label": "Extra Large"
        },
        {
          "value": "section-container--full",
          "label": "Full Width"
        }
      ],
      "default": "section-container--lg"
    },
    {
      "type": "video",
      "id": "live_video",
      "label": "Upload Live Video"
    },
    {
  "type": "video_url",
  "id": "video_url",
  "label": "Or Paste Video Link (YouTube/Vimeo)",
  "accept": ["youtube", "vimeo"]
},
    {
      "type": "checkbox",
      "id": "is_live_now",
      "label": "Show LIVE badge",
      "default": false,
      "info": "Enable only while a real live session is running."
    },
    {
      "type": "text",
      "id": "highlight_heading",
      "label": "Highlight Heading",
      "default": "Today's Highlights"
    },
    {
      "type": "text",
      "id": "deals_heading",
      "label": "Deals Heading",
      "default": "Exclusive Live Deals"
    }

  ],

  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight Point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Point"
        }
      ]
    },
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature Icon",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Upload Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Sub Heading"
        }
      ]
    },
    {
      "type": "upcoming_session",
      "name": "Upcoming Session",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Session Image"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge Text (e.g. 10th July)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Session Title"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Redirect Link"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Notify Me"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Live Shopping Section"
    }
  ]
}
{% endschema %}

<script src="{{ 'live-shopping.js' | asset_url }}" defer></script>
