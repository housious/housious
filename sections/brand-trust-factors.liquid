<div class="trust-badges-section" style="background-color: {{ section.settings.bg_color }};">
  <div class="trust-badges-container">
    
    {%- for block in section.blocks -%}
      <div class="badge-card-item" {{ block.shopify_attributes }}>
        
        <div class="badge-icon-box">
          {%- if block.settings.badge_icon != blank -%}
            <img 
              src="{{ block.settings.badge_icon | image_url: width: 80 }}" 
              alt="{{ block.settings.headline_text }}" 
              loading="lazy"
              width="40"
              height="40"
            >
          {%- else -%}
            {%- comment -%} Default dynamic fallback svg structure if image is missing {%- endcomment -%}
            <svg viewBox="0 0 24 24" width="32" height="32" stroke="#ff5600" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 8v4l3 3"></path></svg>
          {%- endif -%}
        </div>

        <div class="badge-text-content">
          <h4 class="badge-headline">{{ block.settings.headline_text }}</h4>
          <p class="badge-subline">{{ block.settings.subline_text }}</p>
        </div>

      </div>
    {%- endfor -%}

  </div>
</div>

{% schema %}
{
  "name": "Brand Trust Factors",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fdf6f0"
    }
  ],
  "blocks": [
    {
      "type": "badge_item",
      "name": "Badge Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "badge_icon",
          "label": "Upload Icon (Image/SVG)"
        },
        {
          "type": "text",
          "id": "headline_text",
          "label": "Headline Text",
          "default": "50,000+"
        },
        {
          "type": "text",
          "id": "subline_text",
          "label": "Subline Text",
          "default": "Happy Customers"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Trust Factors",
      "blocks": [
        { "type": "badge_item", "settings": { "headline_text": "50,000+", "subline_text": "Happy Customers" } },
        { "type": "badge_item", "settings": { "headline_text": "4.6 ★", "subline_text": "Average Rating" } },
        { "type": "badge_item", "settings": { "headline_text": "2.5 Lakh+", "subline_text": "Orders Delivered" } },
        { "type": "badge_item", "settings": { "headline_text": "500+", "subline_text": "Cities Served" } }
      ]
    }
  ]
}
{% endschema %}

{% style %}
.trust-badges-section {
  width: 100%;
  padding: 20px 24px;
  box-sizing: border-box;
}

.trust-badges-container {
  max-width: 1280px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 24px;
}

.badge-card-item {
  display: flex;
  align-items: center;
  gap: 14px;
  flex: 1;
  min-width: 220px;
}

.badge-icon-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  flex-shrink: 0;
}

.badge-icon-box img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.badge-text-content {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.badge-headline {
  font-size: 16px;
  font-weight: 800;
  color: #000000;
  margin: 0;
  line-height: 1.2;
  letter-spacing: -0.2px;
}

.badge-subline {
  font-size: 12px;
  font-weight: 500;
  color: #64748b;
  margin: 0;
  line-height: 1.3;
}

/* Fluid responsive mapping logic for mobile viewports */
@media (max-width: 991px) {
  .trust-badges-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px 16px;
  }
  .badge-card-item {
    min-width: unset;
  }
}
{% endstyle %}