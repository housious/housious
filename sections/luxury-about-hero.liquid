{{ 'about.css' | asset_url | stylesheet_tag }}
{% comment %} <section class="luxury-pure-banner section-{{ section.id }}"> {% endcomment %}
 <section class="luxury-pure-banner section-{{ section.id }} section-container {{ section.settings.container_width }}">
  <h1 class="housious-visually-hidden">About Housious</h1>
  <div class="pure-banner__container">
    {% if section.settings.image != blank %}
      <picture class="pure-banner__media">
        {% comment %} Jab screen 767px ya usse choti hogi, tab ye mobile image loading trigger karega {% endcomment %}
        {% if section.settings.image_mobile != blank %}
          <source media="(max-width: 767px)" srcset="{{ section.settings.image_mobile | img_url: '768x' }}">
        {% else %}
          <source media="(max-width: 767px)" srcset="{{ section.settings.image | img_url: '768x' }}">
        {% endif %}
        
        {% comment %} Desktop standard image toggle {% endcomment %}
        <img 
          src="{{ section.settings.image | img_url: '1600x' }}" 
          alt="{{ section.settings.image.alt | escape }}"
          loading="eager"
          class="pure-banner__img"
        >
      </picture>
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'pure-banner__placeholder' }}
    {% endif %}
  </div>
</section>

{% comment %} {% schema %}
{
  "name": "Luxury Pure Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Banner Image",
      "info": "Recommended size: 1600x700px (Wide aspect ratio)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Banner Image (Alag Se Upload)",
      "info": "Recommended size: 768x900px ya 1:1 Square (Mobile vertical screens ke liye)"
    }
  ],
  "presets": [
    {
      "name": "Luxury Pure Banner"
    }
  ]
}
{% endschema %} {% endcomment %}

{% schema %}
{
  "name": "Luxury Pure Banner",
  "settings": [
    {
      "type": "select",
      "id": "container_width",
      "label": "Container Width",
      "options": [
        {
          "value": "section-container--lg",
          "label": "Large"
        },
        {
          "value": "section-container--xl",
          "label": "Extra Large"
        },
        {
          "value": "section-container--full",
          "label": "Full Width"
        }
      ],
      "default": "section-container--xl"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Banner Image",
      "info": "Recommended size: 1600x700px (Wide aspect ratio)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Banner Image (Alag Se Upload)",
      "info": "Recommended size: 768x900px ya 1:1 Square (Mobile vertical screens ke liye)"
    }
  ],
  "presets": [
    {
      "name": "Luxury Pure Banner"
    }
  ]
}
{% endschema %}