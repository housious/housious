          <div class="housious-block-icon">
            <img 
              src="{{ block.settings.icon | image_url: width: 100 }}" 
              alt="{{ block.settings.title | escape }}"
              loading="lazy"
              width="45"
              height="45"
            >
          </div>
        {% endif %}
        
        <div class="housious-block-content">
          {% if block.settings.title != blank %}
            <h4 class="housious-block-title">{{ block.settings.title }}</h4>
          {% endif %}
          {% if block.settings.subtitle != blank %}
            <p class="housious-block-subtitle">{{ block.settings.subtitle }}</p>
          {% endif %}
        </div>

      </div>
    {% endfor %}

  </div>
</div>

{% style %}
.housious-features-section {
