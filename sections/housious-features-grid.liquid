{% comment %} <div class="housious-features-section" style="background-color: {{ section.settings.bg_color }};">
  <div class="housious-features-container">
    
    {% for block in section.blocks %}
      <div class="housious-feature-block" {{ block.shopify_attributes }}>
        
        {% if block.settings.icon != blank %}
          <div class="housious-block-icon">
            <img 
              src="{{ block.settings.icon | image_url: width: 100 }}" 
              alt="{{ block.settings.title | escape }}"
              loading="lazy"
              width="45"
              height="45"
            >
          </div>
        {% endif %}
        
        <div class="housious-block-content">
          {% if block.settings.title != blank %}
            <h4 class="housious-block-title">{{ block.settings.title }}</h4>
          {% endif %}
          {% if block.settings.subtitle != blank %}
            <p class="housious-block-subtitle">{{ block.settings.subtitle }}</p>
          {% endif %}
        </div>

      </div>
    {% endfor %}

  </div>
</div>

{% style %}
.housious-features-section {
  padding: 30px 20px;
  width: 100%;
}

.housious-features-container {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  /* Creates a clean 4-column layout on desktop */
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
  align-items: center;
}

.housious-feature-block {
  display: flex;
  align-items: flex-start;
  gap: 15px;
}

.housious-block-icon {
  flex-shrink: 0;
  width: 45px;
  height: 45px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.housious-block-icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.housious-block-content {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.housious-block-title {
  margin: 0;
  font-size: 15px;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.2;
}

.housious-block-subtitle {
  margin: 0;
  font-size: 12px;
  font-weight: 400;
  color: #666666;
  line-height: 1.3;
}

/* Responsive Breaks for Tablet and Mobile */
@media (max-width: 991px) {
  .housious-features-container {
    grid-template-columns: repeat(2, 1fr); /* 2 columns on tablets */
    gap: 24px;
  }
}

@media (max-width: 575px) {
  .housious-features-container {
    grid-template-columns: 1fr; /* Stack into 1 column on mobile */
    gap: 20px;
  }
  .housious-features-section {
    padding: 24px 15px;
  }
}
{% endstyle %}

{% schema %}
{
  "name": "Housious Features Grid",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fdf8f4" 
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium Quality"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Built to last long"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Housious Features Grid",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %} {% endcomment %}

