  max-width: 1280px; 
  margin: 0 auto;
  padding: 24px 20px;
  width: 100%;
  box-sizing: border-box;
}

.housious-features-container {
  /* CHANGE: Canva matching clean rounded corner soft container background */
  background-color: #fdf8f5; 
  border-radius: 8px;
  padding: 24px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
}

.housious-feature-block {
  display: flex;
  align-items: center; /* CHANGE: Icons aur text baseline centered aligned rahenge */
  gap: 15px;
}

.housious-block-icon {
  flex-shrink: 0;
  width: 40px; /* Canva exact design proportions */
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.housious-block-icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.housious-block-content {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.housious-block-title {
  margin: 0;
  font-size: 14px;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.2;
}

.housious-block-subtitle {
