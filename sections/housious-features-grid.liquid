  font-weight: 500;
  color: #666666;
  line-height: 1.3;
}

/* Responsive Breaks for Tablet and Mobile */
/* ==========================================================================
   MOBILE & TABLET SAFE SIDE-BY-SIDE 4-COLUMN ENGINE
   ========================================================================== */
@media (max-width: 991px) {
  .housious-features-container {
    /* Maintain full 4-column grid layout across tablet viewports */
    grid-template-columns: repeat(4, 1fr) !important;
    gap: 12px !important;
    padding: 16px !important;
  }
}

@media (max-width: 767px) {
  .housious-features-section {
    padding: 10px 10px !important; /* Compact outer spacing */
  }

  .housious-features-container {
    /* Force side-by-side horizontal alignment layout on mobile viewports */
    grid-template-columns: repeat(4, 1fr) !important; 
    gap: 8px !important;            /* Tighten spaces to fit small mobile screens */
    padding: 12px 8px !important;
  }

  .housious-feature-block {
    flex-direction: column !important; /* Stack icon cleanly directly above text content */
    align-items: center !important;
    text-align: center !important;
    gap: 6px !important;
  }

  .housious-block-icon {
    width: 28px !important;          /* Scale down icon sizes gracefully */
    height: 28px !important;
  }

  .housious-block-title {
    font-size: 10px !important;      /* Optimized text scaling to avoid multi-line breaks */
    font-weight: 700 !important;
    line-height: 1.1 !important;
  }

  .housious-block-subtitle {
    font-size: 8px !important;       /* Muted micro text sub-label scale */
    line-height: 1.1 !important;
    margin-top: 1px !important;
  }
}
