{{ 'shop-by-category.css' | asset_url | stylesheet_tag }}

{% comment %} <section class="shop-category-section"> {% endcomment %}

<section 
  class="shop-category-section"
  style="
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  "
>

  <div class="section-container {{ section.settings.container_width }}">

    <div class="shop-category-header">

      <h2 class="shop-category-title">
        {{ section.settings.heading }}
      </h2>

      {% if section.settings.view_all_link != blank %}
        <a
            href="{{ section.settings.view_all_link }}"
            class="shop-category-view-all"
            >
            <span>{{ section.settings.view_all_text }}</span>

            <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
            >
                <path
                d="M5 12H19"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                />
                <path
                d="M13 6L19 12L13 18"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                />
            </svg>
        </a>
       {% endif %}

    </div>

    <div
      class="shop-category-grid"
      style="
        --desktop-columns:{{ section.settings.desktop_columns }};
        --image-size:{{ section.settings.image_size }}px;
      "
    >

      {% for block in section.blocks %}

        {% assign collection = block.settings.collection %}

        {% if collection %}

          <a
            href="{{ collection.url }}"
            class="shop-category-item"
            {{ block.shopify_attributes }}
          >

            <div class="shop-category-image">

              {% if block.settings.custom_image != blank %}

                {{
                  block.settings.custom_image
                  | image_url: width: 300
                  | image_tag
                }}

              {% elsif collection.image %}

                {{
                  collection.image
                  | image_url: width: 300
                  | image_tag
                }}

              {% endif %}

            </div>

            <div class="shop-category-name">
              {{ collection.title }}
            </div>

          </a>

        {% endif %}

      {% endfor %}

      {% if section.settings.show_view_all_item %}

        <a
          href="{{ section.settings.view_all_link }}"
          class="shop-category-item view-all-item"
        >

          <div class="shop-category-image">

            {% if section.settings.view_all_icon != blank %}

              {{
                section.settings.view_all_icon
                | image_url: width: 200
                | image_tag
              }}

            {% else %}

              <svg
                width="30"
                height="30"
                viewBox="0 0 24 24"
                fill="none"
              >
                <rect x="3" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
                <rect x="14" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
                <rect x="3" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
                <rect x="14" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
              </svg>

            {% endif %}

          </div>

          <div class="shop-category-name">
            View All
          </div>

        </a>

      {% endif %}

    </div>

  </div>

</section>

{% schema %}
{
  "name": "Shop By Category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Text",
      "default": "View All Categories"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 6,
      "max": 10,
      "step": 1,
      "label": "Desktop Columns",
      "default": 9
    },
    {
      "type": "range",
      "id": "image_size",
      "min": 60,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Image Size",
      "default": 90
    },
    {
  "type": "range",
  "id": "padding_top",
  "min": 0,
  "max": 100,
  "step": 4,
  "unit": "px",
  "label": "Top Spacing (Desktop)",
  "default": 40
},
{
  "type": "range",
  "id": "padding_bottom",
  "min": 0,
  "max": 100,
  "step": 4,
  "unit": "px",
  "label": "Bottom Spacing (Desktop)",
  "default": 40
},
{
  "type": "range",
  "id": "mobile_padding_top",
  "min": 0,
  "max": 100,
  "step": 4,
  "unit": "px",
  "label": "Top Spacing (Mobile)",
  "default": 20
},
{
  "type": "range",
  "id": "mobile_padding_bottom",
  "min": 0,
  "max": 100,
  "step": 4,
  "unit": "px",
  "label": "Bottom Spacing (Mobile)",
  "default": 20
},
    {
      "type": "checkbox",
      "id": "show_view_all_item",
      "label": "Show View All Item",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "view_all_icon",
      "label": "View All Icon"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container Width",
      "options": [
        {
          "value": "section-container--lg",
          "label": "Large"
        },
        {
          "value": "section-container--xl",
          "label": "Extra Large"
        },
        {
          "value": "section-container--full",
          "label": "Full Width"
        }
      ],
      "default": "section-container--xl"
    }
  ],
  
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop By Category"
    }
  ]
}
{% endschema %}