
{{ 'footer-trust-bar.css' | asset_url | stylesheet_tag }}

{% comment %} <section class="footer-trust-bar section-container {{ section.settings.container_width }}">
  <div class="page-width">
    <div class="footer-trust-bar__wrapper">

      {% for block in section.blocks %}
        <div class="trust-item" {{ block.shopify_attributes }}>

          {% if block.settings.icon != blank %}
            <div class="trust-item__icon">
              {{
                block.settings.icon
                | image_url: width: 200
                | image_tag: loading: 'lazy'
              }}
            </div>
          {% endif %}

          <div class="trust-item__content">
            <h3>{{ block.settings.heading }}</h3>
            <p>{{ block.settings.description }}</p>
          </div>

        </div>
      {% endfor %}

    </div>
  </div>
</section> {% endcomment %}

<section class="footer-trust-bar section-container {{ section.settings.container_width }}">
  {% comment %} page-width class yahan se remove kar dein {% endcomment %}
  <div class="footer-trust-bar__wrapper">
    {% for block in section.blocks %}
      <div class="trust-item" {{ block.shopify_attributes }}>
        {% if block.settings.icon != blank %}
          <div class="trust-item__icon">
            {{ block.settings.icon | image_url: width: 200 | image_tag: loading: 'lazy' }}
          </div>
        {% endif %}
        <div class="trust-item__content">
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.description }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% comment %} {% schema %}
{
  "name": "Footer Trust Bar",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quality You Can Trust"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Premium materials & long lasting products"
        },
         {
            "type": "select",
            "id": "container_width",
            "label": "Container Width",
            "options": [
                {
                "value": "section-container--lg",
                "label": "Large"
                },
                {
                "value": "section-container--xl",
                "label": "Extra Large"
                },
                {
                "value": "section-container--full",
                "label": "Full Width"
                }
            ],
            "default": "section-container--xl"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer Trust Bar",
      "blocks": [
        {
          "type": "trust_item"
        },
        {
          "type": "trust_item"
        },
        {
          "type": "trust_item"
        },
        {
          "type": "trust_item"
        }
      ]
    }
  ]
}
{% endschema %} {% endcomment %}

