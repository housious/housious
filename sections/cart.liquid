<script>
document.getElementById('apply-coupon').addEventListener('click', function() {
  const couponCode = document.getElementById('coupon-input').value.trim();
  const messageElement = document.getElementById('coupon-message');
  
  if (couponCode === "") {
    messageElement.innerText = "Please enter a valid code.";
    messageElement.style.color = "red";
    return;
  }

  // Redirect to checkout with the discount code applied
  // Shopify automatically handles this parameter
  window.location.href = "/checkout?discount=" + encodeURIComponent(couponCode);
});
</script>

{% schema %}
{
  "name": "Cart",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container Width",
      "options": [
        {
          "value": "section-container--sm",
          "label": "Small"
        },
        {
          "value": "section-container--md",
          "label": "Medium"
        },
        {
          "value": "section-container--lg",
          "label": "Large"
        },
        {
          "value": "section-container--xl",
          "label": "Extra Large"
        },
        {
          "value": "section-container--full",
          "label": "Full Width"
        }
      ],
      "default": "section-container--lg"
    }
  ]
}
{% endschema %}