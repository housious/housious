{% comment %} <section class="contact-us-section">
  <div class="page-width"> {% endcomment %}

   <section class="contact-us-section section-container {{ section.settings.container_width }}">
<div class="section-container {{ section.settings.container_width }}">
    <div class="contact-card-container">

          <div class="contact-header">
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subheading }}</p>
    </div>

      <div class="contact-grid">

        <div class="contact-form-wrapper">
          {% form 'contact' %}
            {% if form.posted_successfully? %}
              <p class="success-message">
                Thank you! Your message has been sent successfully.
              </p>
            {% endif %}

            {{ form.errors | default_errors }}

            <div class="form-row">
              <div class="input-group">
                <input
                  type="text"
                  id="ContactFormName"
                  name="contact[name]"
                  placeholder=" "
                  required
                >
                <label for="ContactFormName">Full Name</label>
                <span class="focus-line"></span>
              </div>
              
              <div class="input-group">
                <input
                  type="email"
                  id="ContactFormEmail"
                  name="contact[email]"
                  placeholder=" "
                  required
                >
                <label for="ContactFormEmail">Email Address</label>
                <span class="focus-line"></span>
              </div>
            </div>

            <div class="input-group">
              <input
                type="tel"
                id="ContactFormPhone"
                name="contact[phone]"
                placeholder=" "
              >
              <label for="ContactFormPhone">Phone Number</label>
              <span class="focus-line"></span>
            </div>

            <div class="input-group">
              <textarea
                id="ContactFormMessage"
                name="contact[body]"
                rows="4"
                placeholder=" "
                required
              ></textarea>
              <label for="ContactFormMessage">Your Message</label>
              <span class="focus-line"></span>
            </div>

            <button type="submit" class="button--submit">
              <span>Send Message</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
            </button>
          {% endform %}
        </div>

        <div class="contact-info">
          {% if section.settings.email != blank %}
            <div class="info-card">
              <div class="info-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              </div>
              <div class="info-content">
                <span class="info-label">Email Us</span>
                <span class="info-value"><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></span>
              </div>
            </div>
          {% endif %}

          {% if section.settings.phone != blank %}
            <div class="info-card">
              <div class="info-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              </div>
              <div class="info-content">
                <span class="info-label">Call Us</span>
                <span class="info-value"><a href="tel:{{ section.settings.phone }}">{{ section.settings.phone }}</a></span>
              </div>
            </div>
          {% endif %}

          {% if section.settings.address != blank %}
            <div class="info-card">
              <div class="info-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              </div>
              <div class="info-content">
                <span class="info-label">Visit Us</span>
                <span class="info-value">{{ section.settings.address | newline_to_br }}</span>
              </div>
            </div>
          {% endif %}

          {% if section.settings.hours != blank %}
            <div class="info-card">
              <div class="info-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              </div>
              <div class="info-content">
                <span class="info-label">Working Hours</span>
                <span class="info-value">{{ section.settings.hours }}</span>
              </div>
            </div>
          {% endif %}
        </div>

      </div>
    </div>

    {% if section.settings.map_embed != blank %}
      <div class="contact-map">
        {{ section.settings.map_embed }}
      </div>
    {% endif %}
</div>
  </section>

<style>
/* --- Housious Premium Theme Variables --- */
:root {
  --color-brand-dark: #000000;
  --color-brand-accent: #000000;
  --color-border-light: #EBECEB; 
  --color-bg-light: #FBFBFA; 
  --transition-smooth: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.contact-us-section {
  padding: 20px 20px;
  color: var(--color-brand-dark);
}

{% comment %} .contact-us-section .page-width {
  max-width: 1140px;
  margin: 0 auto;
} {% endcomment %}

/* Header Section */
.contact-header {
  text-align: center;
  margin-bottom:70px;
}

.contact-header h1 {
  font-size: 42px;
  font-weight: 400;
  letter-spacing: -0.03em;
  color: var(--color-brand-dark);
  text-transform: capitalize;
}

.contact-header p {
  font-size: 16px;
  color: #707571;
  max-width: 520px;
  margin: 0 auto;
  line-height: 1.6;
}

/* Premium Outer Card Layout */
.contact-card-container {
  background: #ffffff;
  border: 1px solid var(--color-border-light);
  border-radius: 16px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.02);
  padding: 60px;
  overflow: hidden;
}

.contact-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 80px;
  align-items: start;
}

/* Form Styles with Floating Labels */
.contact-form-wrapper form {
  display: flex;
  flex-direction: column;
  gap: 32px;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}

.input-group {
  position: relative;
  display: flex;
  flex-direction: column;
}

.contact-form-wrapper input,
.contact-form-wrapper textarea {
  width: 100%;
  padding: 16px 0;
  border: none;
  border-bottom: 1px solid #D1D5D2;
  background-color: transparent;
  font-size: 15px;
  color: var(--color-brand-dark);
  transition: var(--transition-smooth);
}

.contact-form-wrapper textarea {
  resize: none;
}

/* Floating Label Logic */
.input-group label {
  position: absolute;
  left: 0;
  top: 16px;
  font-size: 14px;
  color: #8A908B;
  pointer-events: none;
  transition: var(--transition-smooth);
}

.contact-form-wrapper input:focus ~ label,
.contact-form-wrapper input:not(:placeholder-shown) ~ label,
.contact-form-wrapper textarea:focus ~ label,
.contact-form-wrapper textarea:not(:placeholder-shown) ~ label {
  top: -10px;
  font-size: 11px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--color-brand-accent);
}

/* Animated Border Line on Focus */
.focus-line {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 2px;
  background-color: var(--color-brand-dark);
  transition: var(--transition-smooth);
}

.contact-form-wrapper input:focus ~ .focus-line,
.contact-form-wrapper textarea:focus ~ .focus-line {
  width: 100%;
}

.contact-form-wrapper input:focus,
.contact-form-wrapper textarea:focus {
  outline: none;
}

/* Submit Button - Premium Feel */
.button--submit {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 16px 42px;
  background-color: var(--color-brand-dark);
  color: #fff;
  border: 1px solid var(--color-brand-dark);
  border-radius: 50px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  letter-spacing: 0.03em;
  transition: var(--transition-smooth);
}

.button--submit svg {
  transition: var(--transition-smooth);
}

.button--submit:hover {
  background-color: var(--color-brand-accent);
  border-color: var(--color-brand-accent);
  transform: translateY(-2px);
  box-shadow: 0 5px 15px rgba(85, 107, 47, 0.2);
}

.button--submit:hover svg {
  transform: translate(3px, -3px);
}

.success-message {
  padding: 16px;
  background-color: #F4F8F5;
  color: #2E5A36;
  border-left: 3px solid #2E5A36;
  font-size: 14px;
  border-radius: 4px;
}

/* Right Side - Info Cards Styling with Icons */
.contact-info {
  display: flex;
  flex-direction: column;
  gap: 32px;
}

.info-card {
  display: flex;
  gap: 20px;
  align-items: flex-start;
}

.info-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  background: #000000;
  border-radius: 50%;
  color: #ffffff;
  flex-shrink: 0;
}

.info-label {
  display: block;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #8A908B;
  margin-bottom: 4px;
}

.info-value {
  display: block;
  font-size: 15px;
  font-weight: 400;
  line-height: 1.6;
}

.info-value a {
  color: inherit;
  text-decoration: none;
  background-image: linear-gradient(currentColor, currentColor);
  background-position: 0% 100%;
  background-repeat: no-repeat;
  background-size: 0% 1px;
  transition: background-size 0.3s;
}

.info-value a:hover {
  background-size: 100% 1px;
}

/* Map Section */
.contact-map {
  margin-top: 60px;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
}

.contact-map iframe {
  width: 100%;
  height: 420px;
  border: 0;
  display: block;
  filter: grayscale(0.2) contrast(1.1); /* Matches premium brand tone */
}

/* Responsive Styles */
/* Optimized Responsive Styles */
@media(max-width: 991px) {
  .contact-card-container {
    padding: 40px;
  }
  .contact-grid {
    grid-template-columns: 1fr;
    gap: 10px;
  }
}

@media(max-width: 576px) {
  .contact-us-section {
    padding: 40px 0; /* Full bleed screen coverage */
   
  }
  
  .contact-header {
    padding: 0 20px;
    margin-bottom: 30px;
  }
  
  .contact-header h1 {
    font-size: 32px; /* Scales down perfectly for mobile headers */
  }

  .contact-card-container {
    padding: 10px 20px 40px 20px; /* Removes tight box padding */
    border: none; /* Removes heavy box outlines on small displays */
    box-shadow: none; /* Cleans up unnecessary shadows */
    border-radius: 0;
  }
  
  .contact-form-wrapper form {
    gap: 28px; /* Slightly compact gaps for easier scrolling */
  }

  .form-row {
    grid-template-columns: 1fr;
    gap: 28px;
  }
  
  .button--submit {
    width: 100%;
    justify-content: center;
    padding: 16px 20px;
    font-size: 15px;
  }

  .contact-info {
    gap: 5px;
    margin-top: 20px;
  }

  .info-card {
    gap: 16px;
    background: #FBFBFA; /* Wraps individual contact elements in neat cards */
    padding: 16px;
    border-radius: 12px;
    border: 1px solid var(--color-border-light);
  }

  .contact-map {
    margin-top: 40px;
    border-radius: 0; /* Edge to edge map looks cleaner on mobile */
    border-left: none;
    border-right: none;
  }
  
  .contact-map iframe {
    height: 320px; /* Reduces excessive scrolling height */
  }
}

@media(max-width: 576px) {
  .contact-us-section {
    padding: 20px 15px;
  }
  .contact-card-container {
    padding: 30px 20px;
    border-radius: 12px;
  }
  .form-row {
    grid-template-columns: 1fr;
    gap: 32px;
  }
  .button--submit {
    width: 100%;
    justify-content: center;
  }
}
</style>
