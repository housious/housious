{% comment %} <div class="housious-header-wrapper section-{{ section.id }}">
  <div class="container">
    <div class="housious-text-content">
      <h1 class="housious-main-title">{{ section.settings.title }}</h1>
      <div class="housious-divider"></div>
      <p class="housious-description">{{ section.settings.description }}</p>
    </div>
  </div>
</div> {% endcomment %}

<div class="housious-header-wrapper section-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <!-- Added the common container with dynamic width setting -->
  <div class="section-container {{ section.settings.container_width }}">
    
    <div class="housious-text-content">
      <h1 class="housious-main-title">{{ section.settings.title }}</h1>
      <div class="housious-divider"></div>
      <p class="housious-description">{{ section.settings.description }}</p>
    </div>
    
  </div>
</div>
{% comment %} 
{% schema %}
{
  "name": "Housious Blog Header",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "HOUSIOUS JOURNAL"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Sub-heading",
      "default": "A curated space for home inspiration, kitchen hacks, and the art of living beautifully."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Housious Blog Header"
    }
  ]
}
{% endschema %} {% endcomment %}
 {% schema %}
{
  "name": "Housious Blog Header",
  "settings": [
    {
      "type": "select",
      "id": "container_width",
      "label": "Container Width",
      "options": [
        { "value": "section-container--lg", "label": "Large" },
        { "value": "section-container--xl", "label": "Extra Large" },
        { "value": "section-container--full", "label": "Full Width" }
      ],
      "default": "section-container--xl"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "HOUSIOUS JOURNAL"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Sub-heading",
      "default": "A curated space for home inspiration, kitchen hacks, and the art of living beautifully."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Housious Blog Header"
    }
  ]
}
{% endschema %}

<style>
.housious-header-wrapper {
  background-color: {{ section.settings.bg_color }};
  padding: 30px;
  text-align: center;
}

.housious-text-content {
  max-width: 800px;
  margin: 0 auto;
}

.housious-main-title {

  font-size: 42px;
  font-weight: 500;
  letter-spacing: 5px; /* Premium letter spacing */
  text-transform: uppercase;
  color: #1a1a1a;
  margin: 0 0 15px 0;
}

{% comment %} .housious-divider {
  width: 40px;
  height: 2px;
  background-color: #1a1a1a;
  margin: 0 auto 25px auto;
} {% endcomment %}

.housious-description {
  font-size: 16px;
  line-height: 1.6;
  color: #555555;
  font-style: italic;
  max-width: 600px;
  margin: 0 auto;
}

/* Responsive for Mobile */
@media (max-width: 768px) {
  .housious-main-title { font-size: 28px; letter-spacing: 3px; }
  .housious-header-wrapper { padding: 50px 15px 30px 15px; }
}
@media (max-width: 768px) {
  .housious-header-wrapper {
    padding: 30px 15px; /* Reduced vertical and horizontal padding */
  }

  .housious-main-title {
    font-size: 24px;      /* Smaller font for mobile */
    letter-spacing: 2px;  /* Reduced spacing for better fit */
    margin-bottom: 10px;
  }

  .housious-description {
    font-size: 14px;      /* Slightly smaller text for mobile */
    line-height: 1.5;
  }
}
</style>
