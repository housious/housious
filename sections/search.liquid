{% comment %} Store search results. Product cards use the shared lightweight card component. {% endcomment %}

<h1 class="housious-visually-hidden">Search Housious</h1>

{% if search.performed %}
  {% if search.results_count == 0 %}
    <div class="search-empty-state section-container section-container--lg">
      <h2>No results found for “{{ search.terms | escape }}”</h2>
      <p>Try a different product name or browse our popular collections.</p>

      <form action="{{ routes.search_url }}" method="get" role="search" class="search-empty-form">
        <label class="housious-visually-hidden" for="SearchEmptyInput-{{ section.id }}">Search products</label>
        <input id="SearchEmptyInput-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products">
        <button type="submit">Search</button>
      </form>

      <div class="search-recovery-links">
        <a href="/collections/best-seller">Best Sellers</a>
        <a href="/collections/new-arrival">New Arrivals</a>
        <a href="/collections/all">Shop All</a>
      </div>
    </div>
  {% else %}
    <div class="search-toolbar section-container section-container--lg">
      <p class="search-results-info">{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}</p>

      <form action="{{ routes.search_url }}" method="get" class="search-controls-form">
        <input type="hidden" name="q" value="{{ search.terms | escape }}">

        {%- if search.filters.size > 0 -%}
          <details class="search-filter-panel">
            <summary>Filter</summary>
            <div class="search-filter-panel__content">
              {%- for filter in search.filters -%}
                <fieldset class="search-filter-group">
                  <legend>{{ filter.label }}</legend>
                  {%- if filter.type == 'price_range' -%}
                    {%- assign search_price_max = filter.range_max | divided_by: 100.0 -%}
                    <div class="search-price-filter">
                      <label>
                        <span>Min</span>
                        <input
                          type="number"
                          name="{{ filter.min_value.param_name }}"
                          min="0"
                          max="{{ search_price_max }}"
                          step="1"
                          {% if filter.min_value.value != blank %}value="{{ filter.min_value.value | divided_by: 100.0 | round }}"{% endif %}
                          placeholder="0"
                        >
                      </label>
                      <label>
                        <span>Max</span>
                        <input
                          type="number"
                          name="{{ filter.max_value.param_name }}"
                          min="0"
                          max="{{ search_price_max }}"
                          step="1"
                          {% if filter.max_value.value != blank %}value="{{ filter.max_value.value | divided_by: 100.0 | round }}"{% endif %}
                          placeholder="{{ search_price_max | round }}"
                        >
                      </label>
                    </div>
                  {%- else -%}
                    <div class="search-filter-values">
                      {%- for value in filter.values -%}
                        <label class="search-filter-value{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                          <input
                            type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            {% if value.active %}checked{% endif %}
                            {% if value.count == 0 and value.active == false %}disabled{% endif %}
                          >
                          <span>{{ value.label }} ({{ value.count }})</span>
                        </label>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </fieldset>
              {%- endfor -%}
            </div>
          </details>
        {%- endif -%}

        {%- assign sort_by = search.sort_by | default: search.default_sort_by -%}
        {%- if search.sort_options.size > 1 -%}
          <label class="search-sort-control" for="SearchSortBy-{{ section.id }}">
            <span>Sort by</span>
            <select id="SearchSortBy-{{ section.id }}" name="sort_by">
              {%- for option in search.sort_options -%}
                <option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name | escape }}</option>
              {%- endfor -%}
            </select>
          </label>
        {%- endif -%}

        <button type="submit" class="search-apply-controls">Apply</button>
        <a class="search-clear-controls" href="{{ routes.search_url }}?q={{ search.terms | url_encode }}">Clear</a>
      </form>
    </div>

    <div class="search-results">
      {% paginate search.results by 20 %}
        {% for result in search.results %}
          <div class="search-result-item">
            {% if result.object_type == 'product' %}
              {%- assign card_loading = 'lazy' -%}
              {%- if forloop.index <= 5 -%}{%- assign card_loading = 'eager' -%}{%- endif -%}
              {% render 'product-card', card_product: result, image_loading: card_loading %}
            {% else %}
              <div class="non-product-result">
                <h3>{{ result.title | link_to: result.url }}</h3>
              </div>
            {% endif %}
          </div>
        {% endfor %}

        {% if paginate.pages > 1 %}
          <div class="pagination" style="grid-column:1 / -1;text-align:center;">
            {{ paginate | default_pagination }}
          </div>
        {% endif %}
      {% endpaginate %}
    </div>
  {% endif %}
{% endif %}

{% stylesheet %}
.search-toolbar {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
  padding-top:20px;
}
.search-results-info { margin:0; font-size:16px; font-weight:500; color:#333; }
.search-controls-form { display:flex; align-items:center; justify-content:flex-end; flex-wrap:wrap; gap:10px; }
.search-filter-panel { position:relative; }
.search-filter-panel summary { min-height:40px; display:flex; align-items:center; cursor:pointer; border:1px solid #ddd; border-radius:6px; padding:0 12px; font-size:14px; font-weight:600; list-style:none; }
.search-filter-panel summary::-webkit-details-marker { display:none; }
.search-filter-panel__content { position:absolute; z-index:20; right:0; top:calc(100% + 8px); width:min(460px,90vw); max-height:60vh; overflow:auto; padding:16px; background:#fff; border:1px solid #e5e5e5; border-radius:8px; box-shadow:0 12px 30px rgba(0,0,0,.12); }
.search-filter-group { border:0; padding:0 0 14px; margin:0 0 14px; border-bottom:1px solid #eee; }
.search-filter-group:last-child { border-bottom:0; margin-bottom:0; padding-bottom:0; }
.search-filter-group legend { font-weight:700; margin-bottom:8px; }
.search-filter-values { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px 14px; }
.search-filter-value { display:flex; align-items:center; gap:7px; font-size:13px; }
.search-filter-value.is-disabled { opacity:.45; }
.search-price-filter { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.search-price-filter label { display:grid; gap:5px; font-size:12px; }
.search-price-filter input { width:100%; min-height:40px; border:1px solid #ddd; border-radius:6px; padding:0 10px; }
.search-sort-control { display:flex; align-items:center; gap:8px; font-size:14px; }
.search-sort-control select { min-height:40px; border:1px solid #ddd; border-radius:6px; padding:0 32px 0 10px; background:#fff; }
.search-apply-controls { min-height:40px; border:0; border-radius:6px; padding:0 16px; background:#111; color:#fff; font-weight:700; cursor:pointer; }
.search-clear-controls { min-height:40px; display:inline-flex; align-items:center; color:#333; font-size:13px; text-decoration:underline; }
.search-results { display:grid; grid-template-columns:repeat(2,1fr); gap:10px; padding:20px; }
.search-result-item { width:100%; }
.search-results .pagination { grid-column:1 / -1; text-align:center; margin-top:30px; }
.search-empty-state { padding-top:48px; padding-bottom:48px; text-align:center; }
.search-empty-state h2 { margin:0 0 8px; }
.search-empty-state p { margin:0 0 22px; color:#666; }
.search-empty-form { max-width:560px; margin:0 auto 20px; display:flex; gap:8px; }
.search-empty-form input { flex:1; min-width:0; min-height:44px; border:1px solid #ccc; border-radius:6px; padding:0 12px; }
.search-empty-form button { min-height:44px; border:0; border-radius:6px; padding:0 18px; background:#111; color:#fff; font-weight:700; cursor:pointer; }
.search-recovery-links { display:flex; justify-content:center; flex-wrap:wrap; gap:10px; }
.search-recovery-links a { border:1px solid #ddd; border-radius:999px; padding:9px 14px; text-decoration:none; color:#111; }
.non-product-result { padding:16px; border:1px solid #eee; border-radius:8px; }
@media (min-width:768px) {
  .search-results { grid-template-columns:repeat(5,1fr); gap:20px; padding:20px; }
}
@media (max-width:767px) {
  .search-toolbar { align-items:flex-start; flex-direction:column; padding-left:20px; padding-right:20px; }
  .search-controls-form { width:100%; justify-content:flex-start; }
  .search-filter-panel__content { left:0; right:auto; width:min(360px,calc(100vw - 40px)); }
  .search-sort-control { flex:1; min-width:210px; }
  .search-sort-control select { flex:1; min-width:0; }
  .search-filter-values { grid-template-columns:1fr; }
  .search-empty-form { flex-direction:column; }
  .search-empty-form button { width:100%; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}
