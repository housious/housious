{% stylesheet %}
 
  .collections {
    display: grid;
    grid-template-columns: repeat(5, 1fr); /* 5 items ek line mein */
    gap: 40px 20px; /* Vertical gap zyada, horizontal kam */
    padding: 40px 20px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .collections-header {
  width: 100%;
  max-width: 900px;
  margin: 30px auto 10px;
  padding: 0 16px;
  text-align: center;
  box-sizing: border-box;
}

.collections-eyebrow {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 14px;
  margin-bottom: 8px;
}

.collections-eyebrow-line {
  display: block;
  width: 25px;
  height: 1px;
  background: #ff6a00;
}

.collections-eyebrow-text {
  color: #ff6a00;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 6px;
  line-height: 1;
  text-transform: uppercase;
}

.collections-main-heading {
  margin: 0 0 8px;
  font-size: clamp(34px, 5vw, 52px);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -1.5px;
}

.collections-heading-dark {
  color: #111111;
}

.collections-heading-accent {
  color: #ff6a00;
}

.collections-subheading {
  margin: 0;
  color: #666666;
  font-size: clamp(14px, 1.5vw, 17px);
  line-height: 1.5;
}

.collections-heading-decoration {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 14px;
}

.collections-heading-decoration-main {
  width: 45px;
  height: 2px;
  background: #ff6a00;
}

.collections-heading-decoration-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #ff6a00;
}

.collections-heading-decoration-small {
  width: 39px;
  height: 1px;
  background: #ff9b59;
}

@media screen and (max-width: 600px) {
  .collections-header {
    margin-top: 20px;
    padding: 0 10px;
  }

  .collections-eyebrow {
    gap: 9px;
    margin-bottom: 7px;
  }

  .collections-eyebrow-line {
    width: 18px;
  }

  .collections-eyebrow-text {
    font-size: 9px;
    letter-spacing: 4px;
  }

  .collections-main-heading {
    margin-bottom: 7px;
    font-size: clamp(27px, 9vw, 36px);
    letter-spacing: -0.8px;
  }

  .collections-subheading {
    font-size: 13px;
  }

  .collections-heading-decoration {
    margin-top: 11px;
  }
}

@media screen and (max-width: 360px) {
  .collections-main-heading {
    font-size: 26px;
  }

  .collections-eyebrow-text {
    letter-spacing: 3px;
  }

  .collections-subheading {
    font-size: 12px;
  }
}

