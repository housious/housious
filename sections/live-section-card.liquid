{{ 'live-section-card.css' | asset_url | stylesheet_tag }}

<section class="section-container {{ section.settings.container_width }}">
    <div class="live-promo-section ">
        {% if section.settings.heading != blank %}
            <h2 class="live-promo-heading">{{ section.settings.heading }}</h2>
        {% endif %}

        <div class="live-promo-grid">

            <!-- Top row: promo cards -->
            <div class="live-promo-row live-promo-row--top">
            {% for block in section.blocks %}
                {% if block.type == 'promo_card' %}
                
                <a href="{{ block.settings.link | default: '#' }}"
                    class="live-promo-card"
                    style="background:{{ block.settings.bg_color | default: '#f7f5f2' }};"
                    {{ block.shopify_attributes }}>

                    <div class="live-promo-card-text">
                    {% if block.settings.title != blank %}
                        <h3>{{ block.settings.title }}</h3>
                    {% endif %}

                    {% if block.settings.subtitle != blank %}
                        <p>{{ block.settings.subtitle }}</p>
                    {% endif %}

                    {% if block.settings.badge_text != blank %}
                        <span class="live-promo-badge">
                        
                        {{ block.settings.badge_text }}
                        </span>
                    {% endif %}

                    {% if block.settings.badge_icon != blank %}
                            <img src="{{ block.settings.badge_icon | image_url }}" alt="">
                        {% endif %}

                    {% if block.settings.cta_text != blank %}
                        <button
  type="button"
  class="live-promo-cta live-add-combo-btn"
  data-items='[
    {% for product in block.settings.products %}
      {% assign variant = product.selected_or_first_available_variant %}
      { "id": {{ variant.id }}, "quantity": 1 }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]'
>
  {{ block.settings.cta_text }}

                        {% if block.settings.show_arrow %}
    <svg class="live-promo-cta-icon" width="18" height="18" viewBox="0 0 24 24" fill="white">
      <path
        d="M5 12H19"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      />
      <path
        d="M13 6L19 12L13 18"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  {% endif %}
                        </button>
                    {% endif %}
                    </div>

                    {% if block.settings.image != blank %}
                    <div class="live-promo-card-image">
                        <img
                        src="{{ block.settings.image | image_url: width: 300 }}"
                        alt="{{ block.settings.title | escape }}"
                        loading="lazy">
                    </div>
                    {% endif %}

                </a>
                {% endif %}
            {% endfor %}
            </div>

            <!-- Bottom row: benefits, host, notify -->
            <div class="live-promo-row live-promo-row--bottom">

            {% for block in section.blocks %}

                {% if block.type == 'benefits_list' %}
                <div class="live-promo-benefits" {{ block.shopify_attributes }}>
                    {% if block.settings.heading != blank %}
                    <h4>{{ block.settings.heading }}</h4>
                    {% endif %}

                    <ul>
                    {% assign items = block.settings.items | newline_to_br | split: '<br />' %}
                    {% for item in items %}
                        {% if item != blank %}
                        <li>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                            <path d="M12 2L14.5 8.5L21 9.5L16.5 14L17.5 21L12 17.5L6.5 21L7.5 14L3 9.5L9.5 8.5L12 2Z" fill="#ff7a1a"/>
                            </svg>
                            {{ item | strip }}
                        </li>
                        {% endif %}
                    {% endfor %}
                    </ul>

                    {% if block.settings.image != blank %}
                    <div class="live-promo-benefits-image">
                        <img src="{{ block.settings.image | image_url: width: 200 }}" alt="" loading="lazy">
                    </div>
                    {% endif %}
                </div>
                {% endif %}

                {% if block.type == 'host' %}
                <div class="live-promo-host" {{ block.shopify_attributes }}>
                    {% if block.settings.heading != blank %}
                    <h4>{{ block.settings.heading }}</h4>
                    {% endif %}

                    <div class="live-promo-host-body">
                    {% if block.settings.image != blank %}
                        <img
                        class="live-promo-host-avatar"
                        src="{{ block.settings.image | image_url: width: 120 }}"
                        alt="{{ block.settings.name | escape }}"
                        loading="lazy">
                    {% endif %}

                    <div class="live-promo-host-info">
                        {% if block.settings.name != blank %}
                        <strong>{{ block.settings.name }}</strong>
                        {% endif %}

                        {% if block.settings.role != blank %}
                        <span class="live-promo-host-role">{{ block.settings.role }}</span>
                        {% endif %}

                        {% if block.settings.bio != blank %}
                        <p>{{ block.settings.bio }}</p>
                        {% endif %}

                        <div class="live-promo-host-social">
                        {% if block.settings.instagram_url != blank %}
                            <a href="{{ block.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/></svg>
                            </a>
                        {% endif %}

                        {% if block.settings.youtube_url != blank %}
                            <a href="{{ block.settings.youtube_url }}" target="_blank" rel="noopener" aria-label="YouTube">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="2" y="5" width="20" height="14" rx="4" stroke="currentColor" stroke-width="1.8"/><path d="M10 9.5L15 12L10 14.5V9.5Z" fill="currentColor"/></svg>
                            </a>
                        {% endif %}
                        </div>
                    </div>
                    </div>
                </div>
                {% endif %}

                {% if block.type == 'notify' %}
                <div class="live-promo-notify" {{ block.shopify_attributes }}>

                    <div class="live-promo-notify-icon">
                      <div class="notify-icon-ring"></div>
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none">
                        <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z" fill="#ff7a1a"/>
                    </svg>
                    </div>

                    {% if block.settings.heading != blank %}
                    <h4>
                        {{ block.settings.heading }}
                        {% if block.settings.highlight_word != blank %}
                        <span class="live-promo-notify-highlight">{{ block.settings.highlight_word }}</span>
                        {% endif %}
                    </h4>
                    {% endif %}

                    {% if block.settings.description != blank %}
                    <p>{{ block.settings.description }}</p>
                    {% endif %}

                    {% form 'customer', id: 'live-promo-notify-form', class: 'live-promo-notify-form' %}
                    <input type="hidden" name="contact[tags]" value="newsletter,live-notify">
                    <div class="live-promo-notify-input-group">
                        <input
                        type="email"
                        name="contact[email]"
                        placeholder="{{ block.settings.placeholder | default: 'Enter your email' }}"
                        required>
                        <button type="submit">{{ block.settings.button_text | default: 'Notify Me' }}</button>
                    </div>

                    {% if form.posted_successfully? %}
                        <p class="live-promo-notify-success">You're on the list!</p>
                    {% endif %}
                    {% endform %}

                    {% if block.settings.footnote != blank %}
                    <span class="live-promo-notify-footnote">{{ block.settings.footnote }}</span>
                    {% endif %}

                </div>
                {% endif %}

            {% endfor %}

            </div>

        </div>
    </div>

</section>

{{ 'add-to-drawer-live.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Live Shopping Promo",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Watch, Shop & Save More"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container Width",
      "options": [
        {
          "value": "section-container--sm",
          "label": "Small"
        },
        {
          "value": "section-container--md",
          "label": "Medium"
        },
        {
          "value": "section-container--lg",
          "label": "Large"
        },
        {
          "value": "section-container--xl",
          "label": "Extra Large"
        },
        {
          "value": "section-container--full",
          "label": "Full Width"
        }
      ],
      "default": "section-container--lg"
    }
  ],
  "blocks": [
    {
      "type": "promo_card",
      "name": "Promo Card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" },
        { "type": "text", "id": "badge_text", "label": "Badge Text (e.g. Use Code: LIVE10)" },
        { "type": "image_picker", "id": "badge_icon", "label": "Badge Icon (optional)" },
        { "type": "text", "id": "cta_text", "label": "CTA Button Text" },
        { "type": "checkbox", "id": "show_arrow", "label": "Show arrow on CTA", "default": true },
        { "type": "image_picker", "id": "image", "label": "Right-side Image" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#f7f5f2" },
        { "type": "product_list", "id": "products", "label": "Live products" }
      ]
    },
    {
      "type": "benefits_list",
      "name": "Why Watch Live (Benefits)",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Why Watch Live?" },
        {
          "type": "textarea",
          "id": "items",
          "label": "Benefit items (one per line)",
          "default": "Exclusive Live Discounts\nLive Demos & Product Details\nReal-time Q&A\nLimited Time Offers\nFree Gifts & Surprises"
        },
        { "type": "image_picker", "id": "image", "label": "Decorative Image" }
      ]
    },
    {
      "type": "host",
      "name": "Meet Your Host",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Meet Your Host" },
        { "type": "image_picker", "id": "image", "label": "Host Photo" },
        { "type": "text", "id": "name", "label": "Host Name" },
        { "type": "text", "id": "role", "label": "Role / Title" },
        { "type": "textarea", "id": "bio", "label": "Short Bio" },
        { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
        { "type": "url", "id": "youtube_url", "label": "YouTube URL" }
      ]
    },
    {
      "type": "notify",
      "name": "Never Miss a Live",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Never" },
        { "type": "text", "id": "highlight_word", "label": "Highlighted Word", "default": "Miss" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Get notified about our upcoming live sessions" },
        { "type": "text", "id": "placeholder", "label": "Input Placeholder", "default": "Enter your email" },
        { "type": "text", "id": "button_text", "label": "Button Text", "default": "Notify Me" },
        { "type": "text", "id": "footnote", "label": "Footnote", "default": "No spam. Unsubscribe anytime." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Live Shopping Promo",
      "blocks": [
        { "type": "promo_card" },
        { "type": "promo_card" },
        { "type": "promo_card" },
        { "type": "benefits_list" },
        { "type": "host" },
        { "type": "notify" }
      ]
    }
  ]
}
{% endschema %}