      "id": "right_image",
      "label": "Right Highlight Image"
    },
    {
      "type": "inline_richtext",
      "id": "shipping_text",
      "label": "Shipping & Returns Policy Text",
      "default": "Free shipping on orders above ₹499. Returns are accepted within 7 days of delivery for unused and undamaged products only."
