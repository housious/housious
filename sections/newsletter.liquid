{% schema %}
{
  "name": "Newsletter Signup",
  "tag": "section",
  "class": "newsletter-section-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "container_width",
      "label": "Container Width",
      "options": [
        { "value": "section-container--lg", "label": "Large" },
        { "value": "section-container--xl", "label": "Extra Large" },
        { "value": "section-container--full", "label": "Full Width" }
      ],
      "default": "section-container--xl"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Housious Club"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Get exclusive home inspiration and kitchen organization hacks directly in your inbox."
    }
  ],
  "presets": [
    {
      "name": "Newsletter Signup"
    }
  ]
}
{% endschema %}
