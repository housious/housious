[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          },
          {
            "value": "100%",
            "label": "Full Width"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "page_margin_desktop",
        "label": "Desktop Side Spacing",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "default": 32
      },
      {
        "type": "range",
        "id": "page_margin_mobile",
        "label": "Mobile Side Spacing",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 16
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "url",
        "id": "social_facebook_link",
        "label": "Facebook URL"
      },
      {
        "type": "url",
        "id": "social_instagram_link",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "social_youtube_link",
        "label": "YouTube URL"
      },
      {
        "type": "url",
        "id": "social_pinterest_link",
        "label": "Pinterest URL"
      },
      {
        "type": "url",
        "id": "social_tiktok_link",
        "label": "TikTok URL"
      },
      {
        "type": "url",
        "id": "social_twitter_link",
        "label": "Twitter / X URL"
      },
      {
        "type": "url",
        "id": "social_linkedin_link",
        "label": "LinkedIn URL"
      }
    ]
  },
  {
    "name": "Cart Settings",
    "settings": [
      {
        "type": "radio",
        "id": "cart_type",
        "label": "Cart Behavior",
        "options": [
          {
            "value": "drawer",
            "label": "Cart Drawer"
          },
          {
            "value": "page",
            "label": "Cart Page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "auto_open_cart",
        "label": "Auto Open",
        "default": true,
        "info": "Works only when Cart Drawer is selected."
      }
    ]
  },
  {
    "name": "Cart Drawer",
    "settings": [
      {
        "type": "header",
        "content": "Steal Deals Upsell"
      },
      {
        "type": "collection",
        "id": "cart_drawer_steal_deals_collection",
        "label": "Steal Deals Collection",
        "info": "Products in this collection appear as upsell suggestions in the cart drawer. Leave empty to hide the section."
      },
      {
        "type": "header",
        "content": "Tiered Discount Codes",
        "info": "Create these discount codes in Shopify Admin → Discounts, then paste the code names here."
      },
      {
        "type": "text",
        "id": "cart_tier2_code",
        "label": "Buy 2 — Discount Code (5% off)",
        "default": "BUY2GET5",
        "placeholder": "e.g. BUY2GET5"
      },
      {
        "type": "text",
        "id": "cart_tier3_code",
        "label": "Buy 3 — Discount Code (10% off)",
        "default": "BUY3GET10",
        "placeholder": "e.g. BUY3GET10"
      },
      {
        "type": "text",
        "id": "cart_tier4_code",
        "label": "Buy 4 — Discount Code (15% off)",
        "default": "BUY4GET15",
        "placeholder": "e.g. BUY4GET15"
      },
      {
        "type": "header",
        "content": "Tiered Discount Percentages"
      },
      {
        "type": "range",
        "id": "cart_tier2_discount",
        "label": "Buy 2 discount %",
        "min": 1,
        "max": 50,
        "step": 1,
        "default": 5
      },
      {
        "type": "range",
        "id": "cart_tier3_discount",
        "label": "Buy 3 discount %",
        "min": 1,
        "max": 50,
        "step": 1,
        "default": 10
      },
      {
        "type": "range",
        "id": "cart_tier4_discount",
        "label": "Buy 4 discount %",
        "min": 1,
        "max": 50,
        "step": 1,
        "default": 15
      }
    ]
  }
]
