<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

  
      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'global.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'custom.css' | asset_url | stylesheet_tag }}
    {%- liquid
      assign needs_product_card_assets = false
      if request.page_type == 'index' or request.page_type == 'collection' or request.page_type == 'search' or request.page_type == 'cart' or request.page_type == 'product'
        assign needs_product_card_assets = true
      elsif request.page_type == 'page'
        if page.handle == 'deals-of-the-day' or page.handle == 'all-collections'
          assign needs_product_card_assets = true
        endif
      endif
    -%}

    {%- if request.page_type == 'collection' -%}
      {{ 'collection.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    {%- if request.page_type == 'page' and page.handle == 'deals-of-the-day' -%}
      {{ 'section-deal.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    {%- if needs_product_card_assets -%}
      {{ 'product-card.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {%- if request.page_type == 'collection' and current_page > 1 and collection.products_count <= 24 -%}
      <meta name="robots" content="noindex,follow">
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body>
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}


    {%- if needs_product_card_assets -%}
      <script src="{{ 'product-card-slider.js' | asset_url }}" defer></script>
    {%- endif -%}

    {% render 'cart-drawer' %}

      <script>
      window.themeCartSettings = {
        cartType: "{{ settings.cart_type }}",
        autoOpen: {{ settings.auto_open_cart | json }}
      };
      </script>

      {{ 'cart-drawer.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>
      {%- if request.page_type == 'product' -%}
        <script src="{{ 'fbt-offer-preview.js' | asset_url }}" defer></script>
      {%- endif -%}
  </body>
</html>


