{% comment %} {% comment %}
  Renders collection title, description, and dynamic USP badges side-by-side.
  Accepts:
  - section: {Object} Passes the section object for blocks access.
{% endcomment %}

<div class="canva-exact-header">
  
  <div class="header-left-brand">
    <h1 class="collection-main-title">{{ collection.title }}</h1>
    {%- if section.settings.show_description and collection.description != blank -%}
      <div class="collection-description-text">
        {{ collection.description }}
      </div>
    {%- endif -%}
  </div>

  <div class="header-right-usp-row">
    {%- for block in section.blocks -%}
      {%- if block.type == 'usp_badge' -%}
        <div class="canva-usp-item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon_image != blank -%}
            <img src="{{ block.settings.icon_image | image_url: width: 60 }}" 
                 alt="{{ block.settings.title | escape }}" 
                 width="30" 
                 height="30" 
                 loading="lazy" />
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          
          <div class="canva-usp-info">
            <span class="canva-title">{{ block.settings.title }}</span>
            <span class="canva-subtitle">{{ block.settings.subtitle }}</span>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

</div> {% endcomment %}

