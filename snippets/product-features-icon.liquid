{% comment %} {% if product.metafields.custom.features_with_icon.value != blank %}

  {% for feature in product.metafields.custom.features_with_icon.value %}

    <div class="housious-metaobject-feature-wrapper">
      <div class="housious-feature-card">

        {% if feature.icon.value %}
          <div class="feature-card-icon">
            <img
              src="{{ feature.icon.value | image_url: width: 70 }}"
              alt="{{ feature.text.value | escape }}"
              loading="lazy"
            >
          </div>
        {% endif %}

        {% if feature.text.value %}
          <div class="feature-card-text">
            <p>{{ feature.text.value }}</p>
          </div>
        {% endif %}

      </div>
    </div>

  {% endfor %}

{% endif %} {% endcomment %}

{% if product.metafields.custom.features_with_icon.value != blank %}
  <div class="housious-metaobject-feature-container">

    {% for feature in product.metafields.custom.features_with_icon.value %}
      <div class="housious-metaobject-feature-wrapper">
        <div class="housious-feature-card">

          {% if feature.icon.value %}
            <div class="feature-card-icon">
              <img
                src="{{ feature.icon.value | image_url: width: 100 }}"
                alt="{{ feature.text.value | escape }}"
                loading="lazy"
              >
            </div>
          {% endif %}

          {% if feature.text.value %}
            <div class="feature-card-text">
              {%- assign words = feature.text.value | split: ' ' -%}
              <span class="feature-title-top">{{ words[0] }}</span>
              
              <span class="feature-title-bottom">
                {%- for word in words offset:1 -%}
                  {{ word }} {% unless forloop.last %}{% endunless %}
                {%- endfor -%}
              </span>
            </div>
          {% endif %}

        </div>
      </div>
    {% endfor %}

  </div> 
{% endif %}

<style>
/** ==========================================================================
   CANVA GLOBAL IMPLEMENTATION: TWO-LINE SLIDER ENGINE FOR ALL ICONS
   ========================================================================== */

/* 1. मुख्य कंटेनर बॉक्स (Slider Layout) */
{% comment %} .housious-metaobject-feature-container {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 30px;                 
  width: 100%;
  margin: 20px 0;
  background-color: #fafafa;
  border: 1px solid #eaeaea;  
  border-radius: 12px;
  padding: 16px 24px;

  flex-wrap: nowrap;          
  overflow-x: auto;           
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch; 
} {% endcomment %}

/* 1. Updated Container Box - Removed Scrollbar/Slider effect */
{% comment %} .housious-metaobject-feature-container {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start; 
  gap: 20px 30px;              
  width: 100%;
  margin: 20px 0;
  background-color: #fafafa;
  border: 1px solid #eaeaea;
  border-radius: 12px;
  padding: 16px;
  
  
  flex-wrap: wrap;            
  overflow-x: visible;        
  scroll-behavior: auto;
} {% endcomment %}

/* Remove or comment out the scrollbar customization completely */
/* 
.housious-metaobject-feature-container::-webkit-scrollbar { ... } 
*/

/* स्क्रॉल बार कस्टमाइज़ेशन */
.housious-metaobject-feature-container::-webkit-scrollbar {
  height: 4px;
}
.housious-metaobject-feature-container::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: 4px;
}

/* 2. फ़ीचर रैपर - आइटम्स को सिकुड़ने से रोकेगा */
{% comment %} .housious-metaobject-feature-wrapper {
  display: flex;
  align-items: center;
  flex-shrink: 0;             
} {% endcomment %}

/* 3. फ़ीचर कार्ड */
{% comment %} .housious-feature-card {
  display: flex;
  gap: 12px;                  
  background: transparent;
  border: none;
  padding: 0;
} {% endcomment %}

/* 4. आइकन का साइज */
.feature-card-icon {
  width: 36px;                /* बढ़ा हुआ आइकन साइज */
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;             
}

.feature-card-icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

/* 5. टेक्स्ट इंजन - जो हर आइकन के टेक्स्ट को 2 लाइन में बांटेगा */
.feature-card-text {
  display: flex;
  flex-direction: column;     /* टेक्स्ट को ऊपर-नीचे ब्लॉक में सेट करेगा */
  justify-content: center;
  text-align: left;
}

/* पहली लाइन (पहला शब्द) */
.feature-card-text .feature-title-top {
  font-size: 13px;
  font-weight: 700;           /* बोल्ड लुक */
  color: #000000;
  line-height: 1.2;
}

/* दूसरी लाइन (बाकी का टेक्स्ट) */
.feature-card-text .feature-title-bottom {
  font-size: 13px;
  font-weight: 700;           /* ये भी बोल्ड रहेगा जैसा कैनवा में है */
  color: #1e293b;             
  line-height: 1.2;
  white-space: nowrap;        /* नीचे की लाइन के शब्दों को आपस में टूटने से रोकेगा */
}

/* 📱 मोबाइल रिस्पॉन्सिवनेस */
/* 📱 मोबाइल रिस्पॉन्सिवनेस - UPDATED */
@media (max-width: 767px) {
  .housious-metaobject-feature-container {
    gap: 15px;                /* Reduced gap for smaller screens */
    padding: 10px 12px;       /* Reduced padding */
  }

  .feature-card-icon {
    width: 24px;              /* Reduced from 32px to 24px for smaller icons */
    height: 24px;
  }

  .feature-card-text .feature-title-top,
  .feature-card-text .feature-title-bottom {
    font-size: 10px;          /* Reduced font size for smaller text */
    line-height: 1.1;         /* Tighter line height */
  }

  /* Optional: Adjust gap between icon and text if it looks too wide */
  .housious-feature-card {
    gap: 8px; 
  }
}
</style>

<style>
/* 1. Container - Slider setup */
.housious-metaobject-feature-container {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 30px;
  width: 100%;
  margin: 20px 0;
  background-color: #fafafa;
  border: 1px solid #eaeaea; 
  border-radius: 12px;
  padding: 16px 10px;
  
  /* Slider behavior */
  flex-wrap: nowrap;          /* Desktop aur Mobile dono par ek line mein rakhne ke liye */
  overflow-x: auto;           /* Scroll enable karne ke liye */
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch; 
  
  /* Scrollbar ko hidden karne ke liye (Chrome, Safari, Edge) */
  scrollbar-width: none;      /* Firefox ke liye */
  -ms-overflow-style: none;   /* IE aur Edge ke liye */
}




/* 2. Feature wrapper - Items ko shrink hone se rokna */
.housious-metaobject-feature-wrapper {
  display: flex;
  align-items: center;
  flex-shrink: 0;             /* Ye bahut zaroori hai taaki items squeeze na hon */
}

/* Baaki styles wahi rahengi... */
.housious-feature-card {
  display: flex;
  align-items: center;
  gap: 12px;
}

@media (max-width:767px){
    .housious-metaobject-feature-container {
        margin:0px;
        border: none; 
        border-radius: 0px;
    }
}
</style>